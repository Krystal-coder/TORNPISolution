<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gong-wpf-dragdrop" Version="2.3.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TORNPISolution.GoogolEtherCAT\TORNPISolution.GoogolEtherCAT.csproj" />
    <ProjectReference Include="..\TORNPISolution.Interface\TORNPISolution.Interface.csproj" />
    <ProjectReference Include="..\TORNPISolution.Service\TORNPISolution.Service.csproj" />
    <ProjectReference Include="..\TORNPISolution.Share\TORNPISolution.Share.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!-- 配置文件纳入解决方案资源管理器：
       编辑这份文件即可改默认配置；PreserveNewest 只在源文件更新时覆盖输出目录，
       程序运行时保存的 instruments.json（输出目录）更新则不会被覆盖回去 -->
  <ItemGroup>
    <Content Include="Config\instruments.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
