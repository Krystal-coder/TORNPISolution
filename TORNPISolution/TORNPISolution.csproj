<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gong-wpf-dragdrop" Version="2.3.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TORNPISolution.GoogolEtherCAT\TORNPISolution.GoogolEtherCAT.csproj" />
    <ProjectReference Include="..\TORNPISolution.Interface\TORNPISolution.Interface.csproj" />
    <ProjectReference Include="..\TORNPISolution.Service\TORNPISolution.Service.csproj" />
    <ProjectReference Include="..\TORNPISolution.Share\TORNPISolution.Share.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!-- Config 下的 json 是“初始模板/种子”，不作为每次构建都覆盖输出的内容文件：
       CopyToOutputDirectory 必须为 Never（切勿用 Always），否则每次构建都会用源码模板
       覆盖输出目录，导致用户在配置页保存的修改重启后丢失。首次种子复制交由下面的
       Ensure*Json target（仅当输出目录不存在时复制）负责，之后以输出目录为权威。 -->
  <ItemGroup>
    <None Update="Config\instruments.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Config\protocol_commands.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Config\flashing.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 配置文件（解决方案资源管理器可见）：
       项目内 Config\instruments.json 仅作为初始模板；
       只在输出目录没有 instruments.json 时才复制，之后以输出目录的为准，
       程序在配置页保存的参数（血压仪/ECG/仪器链接）写入输出目录且不会被编译覆盖 -->
  <Target Name="EnsureInstrumentsJson" BeforeTargets="PreBuildEvent">
    <Copy SourceFiles="Config\instruments.json" DestinationFiles="$(OutDir)Config\instruments.json" Condition="!Exists('$(OutDir)Config\instruments.json')" />
  </Target>

  <!-- 协议命令配置模板：只在输出目录没有 protocol_commands.json 时才复制（与 instruments.json 一致）。
       用户在配置页修改并保存的命令码写入输出目录，重新编译不会覆盖；
       源码模板新增的键由 ProtocolCommandConfigService.Load() 回退默认值并告警，
       配置窗按 OrderedKeys 展示全部键，用户下次保存即完整落盘。 -->
  <Target Name="EnsureProtocolCommandsJson" BeforeTargets="PreBuildEvent">
    <Copy SourceFiles="Config\protocol_commands.json" DestinationFiles="$(OutDir)Config\protocol_commands.json" Condition="!Exists('$(OutDir)Config\protocol_commands.json')" />
  </Target>

  <!-- 烧录工位配置模板：只在输出目录没有 flashing.json 时才复制（与 instruments.json 一致）。
       现场在烧录页配的通道串口、工具与固件路径写入输出目录，重新编译不会覆盖。 -->
  <Target Name="EnsureFlashingJson" BeforeTargets="PreBuildEvent">
    <Copy SourceFiles="Config\flashing.json" DestinationFiles="$(OutDir)Config\flashing.json" Condition="!Exists('$(OutDir)Config\flashing.json')" />
  </Target>

</Project>
