<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gong-wpf-dragdrop" Version="2.3.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TORNPISolution.GoogolEtherCAT\TORNPISolution.GoogolEtherCAT.csproj" />
    <ProjectReference Include="..\TORNPISolution.Interface\TORNPISolution.Interface.csproj" />
    <ProjectReference Include="..\TORNPISolution.Service\TORNPISolution.Service.csproj" />
    <ProjectReference Include="..\TORNPISolution.Share\TORNPISolution.Share.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\instruments.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Config\protocol_commands.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 配置文件（解决方案资源管理器可见）：
       项目内 Config\instruments.json 仅作为初始模板；
       只在输出目录没有 instruments.json 时才复制，之后以输出目录的为准，
       程序在配置页保存的参数（血压仪/ECG/仪器链接）写入输出目录且不会被编译覆盖 -->
  <Target Name="EnsureInstrumentsJson" BeforeTargets="PreBuildEvent">
    <Copy SourceFiles="Config\instruments.json" DestinationFiles="$(OutDir)Config\instruments.json" Condition="!Exists('$(OutDir)Config\instruments.json')" />
  </Target>

  <!-- 每次构建时同步协议命令配置模板到输出目录；
       用户在配置页修改的命令码写入输出目录，此处仅同步源码模板中新增的键 -->
  <Target Name="EnsureProtocolCommandsJson" BeforeTargets="PreBuildEvent">
    <Copy SourceFiles="Config\protocol_commands.json" DestinationFiles="$(OutDir)Config\protocol_commands.json" />
  </Target>

</Project>
