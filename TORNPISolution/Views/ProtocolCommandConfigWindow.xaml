<Window x:Class="TORNPISolution.Views.ProtocolCommandConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TORNPISolution.ViewModels"
        xmlns:conv="clr-namespace:TORNPISolution.Converters"
        Title="协议命令配置" Width="680" Height="520"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI">

    <Window.DataContext>
        <vm:ProtocolCommandConfigViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:HexByteConverter x:Key="HexByte"/>
    </Window.Resources>

    <DockPanel>

        <!-- 底部按钮栏 -->
        <Grid DockPanel.Dock="Bottom" Margin="16,10,16,14">
            <TextBlock Text="修改后保存到 Config\protocol_commands.json，运行时热重载"
                       Style="{StaticResource Style.SubText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Style.ToolButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="保存" Style="{StaticResource Style.PrimaryButton}"
                        MinWidth="88" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>

        <!-- DataGrid：命令名称 / 命令码 / 描述 -->
        <Border Style="{StaticResource Style.PanelCard}" Margin="12,10,12,0" Padding="8">
            <DataGrid ItemsSource="{Binding Commands}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="命令名称" Binding="{Binding Name, Mode=OneWay}"
                                        Width="180" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="命令码" Binding="{Binding Code, Converter={StaticResource HexByte}, UpdateSourceTrigger=PropertyChanged}"
                                        Width="100"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
