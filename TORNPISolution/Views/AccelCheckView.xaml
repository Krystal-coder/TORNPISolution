<UserControl x:Class="TORNPISolution.Views.AccelCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TORNPISolution.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:TORNPISolution.Converters"
             mc:Ignorable="d"
             FontFamily="Microsoft YaHei UI"
             d:DataContext="{d:DesignInstance Type=viewModels:AccelCheckViewModel}"
             d:DesignHeight="720" d:DesignWidth="1400">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 选中行不再依赖主题配色  -->
        <Style x:Key="Style.AccelRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Primary.Light}"/>
                </DataTrigger>
                <!-- 超差行放后面：两条同时命中时以红底为准，选中不能把超差盖掉 -->
                <DataTrigger Binding="{Binding IsExceeded}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Fail.Light}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 判定列：超限红、合格绿，标签里读不出角度时灰 -->
        <Style x:Key="Style.AccelVerdict" TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExceeded}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictText}" Value="合格">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 偏差列：只有真超限的那几条加粗，其余按普通数值读 -->
        <Style x:Key="Style.AccelDeviation" TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExceeded}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Style.AccelCell" TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExceeded}" Value="True">
                    <Setter Property="Foreground" Value="#8A1B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 工况条按钮 -->
        <Style x:Key="Style.BarButton" TargetType="Button" BasedOn="{StaticResource Style.PrimaryButton}">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="ChartRow" Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Border Grid.Row="0" Style="{StaticResource Style.PanelCard}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="加速度充电检查" Style="{StaticResource Style.PanelTitle}"/>
                    <TextBlock Style="{StaticResource Style.SubText}" Margin="0,4,0,0" Text="{Binding PortText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="连接" Command="{Binding ConnectCommand}"
                            Style="{StaticResource Style.PrimaryButton}"
                            ToolTip="串口参数取「配置→被测产品」；连上即代产品进入产测态（产品上口后 20 秒内有效）"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource Style.ToolButton}"
                            ToolTip="先点「停止传感器」再断开：退出产测、把采样文件落完再交出口，产品不会被留在产测态（没点断开就回不了整机页）"/>
                    <Button Content="{Binding ChartButtonText}" Command="{Binding ToggleChartCommand}"
                            Style="{StaticResource Style.ToolButton}" MinWidth="78"
                            ToolTip="展开/收起 Roll 折线：一个姿态标签一种配色"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工况条 -->
        <Border Grid.Row="1" Style="{StaticResource Style.PanelCard}" Margin="0,8,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0">
                    <StackPanel Margin="0,0,12,0"
                                ToolTip="写进采样文件的设置角度；名义角优先取「本姿态置零」的示教值，没示教时用标签文本里的角度">
                        <TextBlock Text="姿态标签" Style="{StaticResource Style.FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="120" Style="{StaticResource Style.CfgBox}" Text="{Binding AngleTag, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="切换" Command="{Binding ChangeAngleTagCommand}"
                                    Style="{StaticResource Style.BarButton}"
                                    ToolTip="标签文字变了才另起一段；文字没变时再点一次仍接在这一段里，不会把曲线劈成两段"/>
                            <Button Content="{Binding TeachButtonText}" Command="{Binding TeachCommand}"
                                    Style="{StaticResource Style.BarButton}" Margin="6,0,0,0" MinWidth="78"
                                    ToolTip="把这一档实测的 Roll/Pitch 均值写成名义角，此后按「判定角度」所选的轴比示教角；再点一次撤销"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0" ToolTip="向产品要一次上报的间隔；改了要按「应用」才下发">
                        <TextBlock Text="上报间隔（ms）" Style="{StaticResource Style.FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="80" Style="{StaticResource Style.CfgBox}" Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="应用" Command="{Binding ApplyIntervalCommand}"
                                    Style="{StaticResource Style.BarButton}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="判定角度（°，超差标红）" Style="{StaticResource Style.FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="60" Style="{StaticResource Style.CfgBox}" Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox Width="100" Margin="6,0,0,0" Height="30" VerticalContentAlignment="Center"
                                      ToolTip="选 Roll 或 Pitch 就只判那一轴；选 Roll&amp;Pitch 两轴各自比、任一超差即标红。名义角优先取「本姿态置零」的示教值，没示教时用标签里的角——两轴都判时该角按 Roll 用、Pitch 按 0° 判"
                                      ItemsSource="{Binding CompareAxisOptions}"
                                      SelectedItem="{Binding CompareAxis, Mode=TwoWay}"/>
                            <Button Content="应用判定" Command="{Binding ApplyJudgementCommand}"
                                    Style="{StaticResource Style.BarButton}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,24,0" ToolTip="启动/停止都只动传感器推流，串口保持连接">
                        <TextBlock Text="采集" Style="{StaticResource Style.FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="启动传感器" Command="{Binding StartSensorCommand}"
                                    Style="{StaticResource Style.BarButton}"/>
                            <Button Content="停止传感器" Command="{Binding StopSensorCommand}"
                                    Style="{StaticResource Style.BarButton}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 宽度固定 -->
                    <StackPanel Margin="0,0,12,0" Width="230">
                        <TextBlock Text="电池 / 充电" Style="{StaticResource Style.FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="读取" Command="{Binding QueryChargingCommand}" Margin="0"
                                    Style="{StaticResource Style.BarButton}"
                                    ToolTip="读一次电池与充电状态，不打断采样；读到的值只在这里显示，不进采样文件"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Style.SubText}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding BatteryText}"
                                       Text="{Binding BatteryText}"/>
                        </Grid>
                    </StackPanel>

                </WrapPanel>

                <!-- 数据四键固定钉在右列第一行：不随上面工况组换行，窗口怎么缩放都留在第一行 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top"
                            ToolTip="「开始/停止保存」管文件的开与关；「暂停/继续保存」只掐这段写入，文件不关；清空显示不动已落盘的文件；停止保存只留 PDF 报告与同名标红 xlsx（CSV 是中间文件，出完即删）">
                    <TextBlock Text="数据" Style="{StaticResource Style.FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding SaveButtonText}" Command="{Binding ToggleSaveCommand}"
                                Style="{StaticResource Style.BarButton}"/>
                        <Button Content="{Binding PauseSaveButtonText}" Command="{Binding PauseSaveCommand}"
                                Style="{StaticResource Style.BarButton}"
                                ToolTip="摆姿态前先暂停：表格照常刷新，只是这段采样不写入文件，摆好后继续写入同一段"/>
                        <Button Content="打开目录" Command="{Binding OpenFolderCommand}"
                                Style="{StaticResource Style.BarButton}"/>
                        <Button Content="清空显示" Command="{Binding ClearDisplayCommand}"
                                Style="{StaticResource Style.BarButton}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 采样表 -->
        <Border Grid.Row="2" Style="{StaticResource Style.PanelCard}" Margin="0,8,0,0">
            <DataGrid x:Name="SampleGrid" Margin="0"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" CanUserResizeColumns="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Brush.Panel.Border}"
                      Background="Transparent" BorderThickness="0"
                      RowHeight="30" FontSize="12"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      RowStyle="{StaticResource Style.AccelRow}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader}"/>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding Seq, Mode=OneWay}" Width="60">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="设置角度" Binding="{Binding AngleTag, Mode=OneWay}" Width="1.1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="X(mg)" Binding="{Binding X, Mode=OneWay}" Width="0.8*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Y(mg)" Binding="{Binding Y, Mode=OneWay}" Width="0.8*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Z(mg)" Binding="{Binding Z, Mode=OneWay}" Width="0.8*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Roll(°)" Binding="{Binding RollText, Mode=OneWay}" Width="0.8*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Pitch(°)" Binding="{Binding PitchText, Mode=OneWay}" Width="0.8*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="合矢量(g)" Binding="{Binding ResultantText, Mode=OneWay}" Width="0.9*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="比对角(°)" Binding="{Binding CompareText, Mode=OneWay}" Width="0.9*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="偏差(°)" Binding="{Binding DeviationText, Mode=OneWay}" Width="0.8*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelDeviation}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="判定" Binding="{Binding VerdictText, Mode=OneWay}" Width="70">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.AccelVerdict}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText, Mode=OneWay}" Width="1*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Roll 折线：折叠时这一行收到 0，展开时与采样表各占一半 -->
        <Border Grid.Row="3" Style="{StaticResource Style.PanelCard}" Margin="0,8,0,0" Padding="8" MinHeight="200"
                Visibility="{Binding IsChartVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 图例整条摆在图外面：色块画成一小横段，和线本身同一个样子 -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding RollLegend}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,0,16,4" VerticalContentAlignment="Center" IsChecked="{Binding IsChecked}"
                                      ToolTip="勾掉就不画这个姿态标签采到的段">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                            Background="{Binding Brush}"/>
                                    <TextBlock Text="{Binding Tag}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 横轴窗口：长测只盯最近这一窗，采样中跟着尾部滚，不挤成细缝 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="横轴窗口(秒)" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"
                               Foreground="{StaticResource Brush.Text.Main}"/>
                    <TextBox Width="60" Style="{StaticResource Style.CfgBox}" Text="{Binding RollWindowText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="应用" Style="{StaticResource Style.ToolButton}" Margin="6,0,0,0" MinWidth="44"
                            Command="{Binding ApplyRollWindowCommand}"
                            ToolTip="按填的秒数开窗：窗口贴着最新数据，采样中跟着尾部滚"/>
                    <Button Content="放大" Style="{StaticResource Style.ToolButton}" Margin="6,0,0,0" MinWidth="44"
                            Command="{Binding RollZoomInCommand}" ToolTip="窗口围绕中点缩窄一半（看细节）"/>
                    <Button Content="缩小" Style="{StaticResource Style.ToolButton}" Margin="6,0,0,0" MinWidth="44"
                            Command="{Binding RollZoomOutCommand}" ToolTip="窗口围绕中点放宽一倍；盖住全部数据就回全量视图"/>
                    <Button Content="重置缩放" Style="{StaticResource Style.ToolButton}" Margin="6,0,0,0" MinWidth="60"
                            Command="{Binding RollResetZoomCommand}" ToolTip="回默认窗口宽度并贴着最新数据"/>
                    <Button Content="回到最新" Style="{StaticResource Style.ToolButton}" Margin="6,0,0,0" MinWidth="60"
                            Command="{Binding RollFollowCommand}" ToolTip="窗口拨回贴着尾部"/>
                    <Button Content="清空曲线" Style="{StaticResource Style.ToolButton}" Margin="6,0,0,0" MinWidth="60"
                            Command="{Binding ClearRollCurveCommand}" ToolTip="把曲线缓冲、图例、线一起清掉，从空白重画；已落盘的文件不受影响"/>
                </StackPanel>

                <!-- 留白钉死（左 48 装 Y 轴标签，下 30 装 X 轴标签与轴名）：不钉时图表自己算，标签一多就把上下摊厚，行高一小就没多少地方画线 -->
                <lvc:CartesianChart Grid.Row="2" Margin="0,4,0,0"
                                    DrawMargin="48,8,8,30"
                                    Series="{Binding RollSeries}"
                                    XAxes="{Binding RollXAxes}"
                                    YAxes="{Binding RollYAxes}"
                                    LegendPosition="Hidden"
                                    ZoomMode="X"/>
            </Grid>
        </Border>

        <!-- 底部摘要 -->
        <Border Grid.Row="4" Style="{StaticResource Style.PanelCard}" Margin="0,8,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Style.SubText}" VerticalAlignment="Center"
                           Text="{Binding SummaryText}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.Text.Main}"
                           Text="{Binding HintText}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
