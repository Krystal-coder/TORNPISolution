<Window x:Class="TORNPISolution.Views.InstrumentConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="仪器链接配置" Width="760" Height="580"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="Template.SerialEditor">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="串口号"/>
                <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                          ItemsSource="{Binding DataContext.AvailablePorts,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="波特率"/>
                <ComboBox Grid.Row="0" Grid.Column="4"
                          ItemsSource="{Binding DataContext.BaudRates,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding BaudRate}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="数据位"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding DataContext.DataBitsOptions,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding DataBits}"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="校验位"/>
                <ComboBox Grid.Row="2" Grid.Column="4"
                          ItemsSource="{Binding DataContext.Parities,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Parity}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="停止位"/>
                <ComboBox Grid.Row="4" Grid.Column="1"
                          ItemsSource="{Binding DataContext.StopBitsOptions,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding StopBits}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Template.ModbusSerialEditor">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="串口号"/>
                <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                          ItemsSource="{Binding DataContext.AvailablePorts,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="波特率"/>
                <ComboBox Grid.Row="0" Grid.Column="4"
                          ItemsSource="{Binding DataContext.BaudRates,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding BaudRate}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="从站地址"/>
                <TextBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center"
                         Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="停止位"/>
                <ComboBox Grid.Row="2" Grid.Column="4"
                          ItemsSource="{Binding DataContext.StopBitsOptions,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding StopBits}"/>
            </Grid>
        </DataTemplate>

        <!-- 网口（SCPI Raw Socket）编辑器：IP + 端口 -->
        <DataTemplate x:Key="Template.LanEditor">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Column="0" Text="IP 地址"/>
                <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                         Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="3" Text="端口"/>
                <TextBox Grid.Column="4" VerticalContentAlignment="Center"
                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>
        <!-- 底部按钮栏 -->
        <Grid DockPanel.Dock="Bottom" Margin="16,10,16,14">
            <Button Content="刷新串口" HorizontalAlignment="Left"
                    Style="{StaticResource Style.ToolButton}" Margin="0"
                    Command="{Binding RefreshPortsCommand}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="测试运行中：配置保存已锁定" Foreground="{StaticResource Brush.Fail}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="取消" Style="{StaticResource Style.ToolButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="保存" Style="{StaticResource Style.PrimaryButton}"
                        MinWidth="88" IsEnabled="{Binding CanSave}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 主体：左侧设备导航 + 右侧详情 -->
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设备导航列表 -->
            <ListBox Grid.Column="0" Margin="16,12,8,0" Padding="0"
                     ItemsSource="{Binding DeviceNavView}"
                     SelectedItem="{Binding SelectedDevice}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11" Margin="16,12,0,4"
                                           Foreground="{StaticResource Brush.Text.Sub}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <materialDesign:PackIcon Kind="{Binding Icon}" Width="15" Height="15"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 右侧：详情面板 -->
            <Grid Grid.Column="1" Margin="8,12,16,0">

                <!-- 被测产品（DUT） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.Key}" Value="Product">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Border Style="{StaticResource Style.PanelCard}" Padding="4">
                        <!-- 上下两条 * 行把产测模式这块夹在中间 -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="20"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                    <materialDesign:PackIcon Kind="Chip" Width="18" Height="18"
                                                             Foreground="{StaticResource Brush.Primary}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="被测产品（DUT）"
                                                   Style="{StaticResource Style.PanelTitle}"/>
                                        <TextBlock Text="串口 232 · AT 指令通讯"
                                                   Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <ContentControl Content="{Binding Config.Product}"
                                                ContentTemplate="{StaticResource Template.SerialEditor}"/>
                            </StackPanel>

                            <!-- 产测模式 -->
                            <Border Grid.Row="2" Margin="12,0" Padding="14,12" CornerRadius="6" Background="#F7F9FC">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="进入产测" Style="{StaticResource Style.PrimaryButton}" MinWidth="88"
                                                Command="{Binding EnterProductionModeCommand}"
                                                ToolTip="只在用串口助手手动联调、产品没进这个态时点这里；正常由「加速度充电检查」连接时代发，那一轮占着口或整机在跑时是灰的"/>
                                        <Button Content="退出产测" Style="{StaticResource Style.ToolButton}" MinWidth="88" Margin="12,0,0,0"
                                                Command="{Binding ExitProductionModeCommand}"
                                                ToolTip="产品已在这个态时才亮；点它把产品退回正常态，否则它会一直停在产测里"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="产测模式" Style="{StaticResource Style.GroupTitle}"/>
                                        <TextBlock Style="{StaticResource Style.SubText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="{Binding ProductionModeText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- 压力变送器 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.Key}" Value="PressureTransmitter">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Border Style="{StaticResource Style.PanelCard}" Padding="4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                <materialDesign:PackIcon Kind="Gauge" Width="18" Height="18"
                                                         Foreground="{StaticResource Brush.Primary}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="压力变送器（美仪 P3000-D / 2051-D）"
                                               Style="{StaticResource Style.PanelTitle}"/>
                                    <TextBlock Text="RS485 · Modbus RTU"
                                               Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ContentControl Content="{Binding Config.PressureTransmitter}"
                                            ContentTemplate="{StaticResource Template.ModbusSerialEditor}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 质量流量控制器 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.Key}" Value="MassFlowController">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Border Style="{StaticResource Style.PanelCard}" Padding="4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                <materialDesign:PackIcon Kind="Waves" Width="18" Height="18"
                                                         Foreground="{StaticResource Brush.Primary}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="质量流量控制器（Alicat）"
                                               Style="{StaticResource Style.PanelTitle}"/>
                                    <TextBlock Text="RS485 · Modbus RTU"
                                               Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ContentControl Content="{Binding Config.MassFlowController}"
                                            ContentTemplate="{StaticResource Template.ModbusSerialEditor}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 血压模拟仪（康伟达 / BPA700 二选一） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.Key}" Value="Simulator">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="同一时刻只能启用一台模拟仪，请选择当前接入的设备"
                                   Style="{StaticResource Style.SubText}" Margin="4,0,4,10"/>

                        <!-- 单选：不启用 -->
                        <RadioButton GroupName="Simulator" Margin="4,4,0,4"
                                     Content="不启用模拟仪"
                                     IsChecked="{Binding IsNoSimulatorSelected}"/>

                        <!-- 单选：康伟达 -->
                        <RadioButton GroupName="Simulator" Margin="4,8,0,2"
                                     IsChecked="{Binding IsKangwendaSelected}">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="HeartPulse" Width="14" Height="14"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="康伟达 NIBP 模拟仪（串口 232）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                        <ContentControl Content="{Binding Config.KangwendaSimulator}"
                                        ContentTemplate="{StaticResource Template.SerialEditor}"
                                        Margin="24,0,0,6">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKangwendaSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <!-- 单选：鲸扬 BPA700 -->
                        <RadioButton GroupName="Simulator" Margin="4,8,0,2"
                                     IsChecked="{Binding IsBPA700Selected}">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Usb" Width="14" Height="14"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="鲸扬 BPA700（USB 虚拟串口 VCP）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                        
                        <!-- BPA700 -->
                        <Grid Margin="24,2,0,6">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBPA700Selected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="COM 口" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource Brush.Text.Main}"/>
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding DataContext.AvailablePorts,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding Config.BPA700Simulator.PortName, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        
                        <!-- BPA700 初始化设置：Category / 压力单位 / 袖带容量（默认 Adult/mmHg/500ml） -->
                        <Grid Margin="24,2,0,6">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBPA700Selected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource Brush.Text.Main}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Adult" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Main}"/>
                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              IsChecked="{Binding Bpa700IsNeonatal, Mode=TwoWay}"
                                              Width="50" Height="30" Margin="8,0"/>
                                <TextBlock Text="Neonatal" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Main}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Pressure Unit" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource Brush.Text.Main}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="mmHg" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Main}"/>
                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              IsChecked="{Binding Bpa700IsKPa, Mode=TwoWay}"
                                              Width="50" Height="30" Margin="8,0"/>
                                <TextBlock Text="kPa" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Main}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Air Reservoir" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource Brush.Text.Main}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="500ml" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Main}"/>
                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              IsChecked="{Binding Bpa700IsSmallReservoir, Mode=TwoWay}"
                                              Width="50" Height="30" Margin="8,0"/>
                                <TextBlock Text="100ml" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Main}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="SDK 自动处理通讯参数，无需设置波特率" Margin="24,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Style.SubText}">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBPA700Selected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- 鲸扬 AECG100 多功能综合性能测试仪 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.Key}" Value="Aecg100">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <!-- ── 连接设置 ── -->
                        <Border Style="{StaticResource Style.PanelCard}" Padding="4" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                    <materialDesign:PackIcon Kind="Pulse" Width="18" Height="18"
                                                             Foreground="{StaticResource Brush.Primary}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="鲸扬 AECG100 多功能综合性能测试仪"
                                                   Style="{StaticResource Style.PanelTitle}"/>
                                        <TextBlock Text=" ECG/PPG/SpO2/PWV"
                                                   Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Lbl"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Text="COM 口"/>
                                    <ComboBox Grid.Column="1" IsEditable="True"
                                              ItemsSource="{Binding DataContext.AvailablePorts,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding Config.Aecg100Tester.PortName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="超时(ms)"/>
                                    <TextBox Grid.Column="4" VerticalContentAlignment="Center"
                                             Text="{Binding Config.Aecg100Tester.ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <CheckBox Margin="12,4,12,2" Content="启用该仪器"
                                          IsChecked="{Binding Config.Aecg100Tester.Enabled}"/>
                                <TextBlock Margin="12,4" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.Text.Sub}"
                                           Text="COM 口留空表示自动选择；超时 -1 为无限等待"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="4,4" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Text.Sub}"
                                   Text="提示：ECG 波形参数、心率测试、噪声/阻抗/起搏器、频率扫描等测试参数请在「配置 → ECG参数配置」中设置"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- NFC 读卡器 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.Key}" Value="NfcReader">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Border Style="{StaticResource Style.PanelCard}" Padding="4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                <materialDesign:PackIcon Kind="NfcVariant" Width="18" Height="18"
                                                         Foreground="{StaticResource Brush.Primary}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="THS_HF 高频读写器（岩柱 YZ806/YZ906）"
                                               Style="{StaticResource Style.PanelTitle}"/>
                                    <TextBlock Text="串口连接 NTAG 读写"
                                               Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ContentControl Content="{Binding Config.NfcReader}"
                                            ContentTemplate="{StaticResource Template.SerialEditor}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- IT6411 直流电源 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.Key}" Value="PowerSupply">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Border Style="{StaticResource Style.PanelCard}" Padding="4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                <materialDesign:PackIcon Kind="PowerPlug" Width="18" Height="18"
                                                         Foreground="{StaticResource Brush.Primary}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="艾德克斯 IT6411 双通道直流电源"
                                               Style="{StaticResource Style.PanelTitle}"/>
                                    <TextBlock Text="网口 LAN · SCPI Raw Socket（CH1 30V/3A，CH2 5V/1A）"
                                               Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ContentControl Content="{Binding Config.It6411PowerSupply}"
                                            ContentTemplate="{StaticResource Template.LanEditor}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 预留设备 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.Key}" Value="Reserved">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>

                        <!-- CRY6151B -->
                        <Border Style="{StaticResource Style.PanelCard}" Padding="4" Margin="0,0,0,10" Opacity="0.65">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                    <materialDesign:PackIcon Kind="SpeakerMultiple" Width="18" Height="18"
                                                             Foreground="{StaticResource Brush.Text.Sub}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="CRY6151B 电声测试仪"
                                                   Style="{StaticResource Style.PanelTitle}"/>
                                        <TextBlock Text="通讯方式待确认（网口/串口）"
                                                   Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Background="#EEF1F5" CornerRadius="4" Padding="6,2"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="待接入" FontSize="10"
                                                   Foreground="{StaticResource Brush.Text.Sub}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 电子负载 -->
                        <Border Style="{StaticResource Style.PanelCard}" Padding="4" Opacity="0.65">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                    <materialDesign:PackIcon Kind="LightningBolt" Width="18" Height="18"
                                                             Foreground="{StaticResource Brush.Text.Sub}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="电子负载"
                                                   Style="{StaticResource Style.PanelTitle}"/>
                                        <TextBlock Text="通讯方式待确认（网口/串口）"
                                                   Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Background="#EEF1F5" CornerRadius="4" Padding="6,2"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="待接入" FontSize="10"
                                                   Foreground="{StaticResource Brush.Text.Sub}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
