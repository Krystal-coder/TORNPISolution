<UserControl x:Class="TORNPISolution.Views.WorkbenchEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FontFamily="Microsoft YaHei UI"
             d:DesignHeight="720" d:DesignWidth="1400">

    <!-- 工位选择页 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/Images/logo.ico" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="选择工位" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Main}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">

                <!-- 整机测试 -->
                <Border Width="260" Style="{StaticResource Style.StationCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:PackIcon Grid.Row="0" Kind="Gauge" Width="30" Height="30"
                                                 Foreground="{StaticResource Brush.Primary}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="整机测试" FontSize="17" FontWeight="Bold" TextAlignment="Center"
                                   Margin="0,10,0,0" Foreground="{StaticResource Brush.Text.Main}"/>
                        <TextBlock Grid.Row="2" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Style="{StaticResource Style.SubText}" FontSize="12"
                                   Text="从模块库拖模块组成测试方案"/>
                        <Button Grid.Row="3" Content="进入整机测试" Style="{StaticResource Style.PrimaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                Command="{Binding OpenWholeMachinePageCommand}"/>
                    </Grid>
                </Border>

                <!-- 单板测试 -->
                <Border Width="260" Style="{StaticResource Style.StationCard}" Margin="18,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:PackIcon Grid.Row="0" Kind="Chip" Width="30" Height="30"
                                                 Foreground="{StaticResource Brush.Primary}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="单板测试" FontSize="17" FontWeight="Bold" TextAlignment="Center"
                                   Margin="0,10,0,0" Foreground="{StaticResource Brush.Text.Main}"/>
                        <TextBlock Grid.Row="2" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Style="{StaticResource Style.SubText}" FontSize="12"
                                   Text="测试单板功能"/>
                        <Button Grid.Row="3" Content="进入单板测试" Style="{StaticResource Style.PrimaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                Command="{Binding OpenBoardPageCommand}"/>
                    </Grid>
                </Border>

                <!-- 烧录：两颗芯片一套治具，与测试方案毫无关系 -->
                <Border Width="260" Style="{StaticResource Style.StationCard}" Margin="18,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:PackIcon Grid.Row="0" Kind="FlashOutline" Width="30" Height="30"
                                                 Foreground="{StaticResource Brush.Primary}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="烧录" FontSize="17" FontWeight="Bold" TextAlignment="Center"
                                   Margin="0,10,0,0" Foreground="{StaticResource Brush.Text.Main}"/>
                        <TextBlock Grid.Row="2" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Style="{StaticResource Style.SubText}" FontSize="12"
                                   Text="先烧 SPI Flash、再烧富芮坤"/>
                        <Button Grid.Row="3" Content="进入烧录" Style="{StaticResource Style.PrimaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                Command="{Binding OpenFlashingPageCommand}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 上次停在哪个工位  -->
        <TextBlock Grid.Row="2" Text="{Binding LastStationHintText}" Style="{StaticResource Style.SubText}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"/>
    </Grid>
</UserControl>
