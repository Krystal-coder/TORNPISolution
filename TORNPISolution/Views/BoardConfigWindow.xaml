<Window x:Class="TORNPISolution.Views.BoardConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TORNPISolution.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="单板配置" Width="1160" Height="660" MinWidth="1000" MinHeight="520"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI"
        d:DataContext="{d:DesignInstance Type=viewModels:BoardChannelViewModel}">

    <!-- 单板的工装配置收在一页里：这一路叫什么/跑不跑（通道配置）、这几路落在哪几台设备上（工位仪器）。
         本轮跑哪几项不在这里——那是作业定义，菜单「测试项」单独一扇窗，两者改的频率差得远，
         挤在同一扇窗里只会让人为了勾一项而多开两页。
         工位仪器那三块是从「仪器链接配置」整块搬过来的，那边不再留——一份配置只留一个入口，
         不会出现两处界面各存一份快照、谁后保存谁把对方的数组整份替换掉。 -->
    <Window.Resources>
        <!-- 说明文字：长句必须换行，否则会被列宽裁掉后半句 -->
        <Style x:Key="Style.HintWrap" TargetType="TextBlock" BasedOn="{StaticResource Style.Hint}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>

        <Style x:Key="Style.CellLabel" TargetType="TextBlock" BasedOn="{StaticResource Style.FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 表头与下面每一行写死同一组列宽，所以能正对上 -->
        <Style x:Key="Style.GridHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="Template.BoardLanRow">
            <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="12,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsChecked="{Binding Enabled}"/>
                    <TextBox Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="2" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="3" VerticalContentAlignment="Center"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 一台读码器一行：相机侧那两个口和两段文本都得对得上，列比网口仪器多 -->
        <DataTemplate x:Key="Template.ReaderRow">
            <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="12,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="62"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsChecked="{Binding Enabled}"/>
                    <TextBox Grid.Column="1" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="2" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="3" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="4" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             Text="{Binding TriggerPort, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="5" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             Text="{Binding TriggerText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="6" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             Text="{Binding InteractionRequestText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="7" VerticalContentAlignment="Center"
                             Text="{Binding InteractionReplyText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,12">
            <TextBlock Text="单板配置" Style="{StaticResource Style.PanelTitle}"/>
            <TextBlock Style="{StaticResource Style.SubText}" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0"
                       Text="「通道配置」是八条路各自的位号与跑不跑，「工位仪器」是它们落在哪几台设备上；不点保存就关窗，这两页的改动都不算数。"/>
        </StackPanel>

        <!-- Style.NavTabControl 的模板是左侧竖排页签，TabPanel 横排还是竖排看 TabStripPlacement，必须写 Left -->
        <TabControl Grid.Row="1" Style="{StaticResource Style.NavTabControl}" TabStripPlacement="Left"
                    ItemContainerStyle="{StaticResource Style.NavTabItem}">

            <!-- 页签一：八条通道各自的信息 -->
            <TabItem Header="通道配置">
                <Grid Margin="10,2,4,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Style.PanelCard}" Padding="18,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="430"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="通道" Style="{StaticResource Style.GridHead}"/>
                                    <TextBlock Grid.Column="1" Text="位号" Style="{StaticResource Style.GridHead}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="本轮跑" Style="{StaticResource Style.GridHead}" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="3" Text="参与整批" Style="{StaticResource Style.GridHead}" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="4" Text="这一路落在哪些设备上（按仪器配置算，只读）" Style="{StaticResource Style.GridHead}"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Channels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="0,0,0,1"
                                                    Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="62"/>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="430"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.Text.Main}"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource Style.CfgBox}" Height="28"
                                                             Margin="0,0,10,0"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="卡片、明细与日志里显示的名字，按现场贴的标签填（如 PCB03）"/>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                                              ToolTip="本轮要不要跑这一路：整批只跑勾着的。跑完还是默认全跑，不落盘"/>
                                                    <CheckBox Grid.Column="3" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                                              ToolTip="这条道接没接：关掉的路整批时直接跳过，卡片会灰下来。与右边「本轮跑」是两件事"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding DeviceText}" FontSize="11"
                                                               TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.Text.Sub}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Style="{StaticResource Style.HintWrap}" Margin="2,10,2,0"
                               Text="右边那三行设备落点由「工位仪器」那页算出来，只读：设定电压、信号强度下限这些是按台给的，要改就去改那一台。"/>
                </Grid>
            </TabItem>

            <!-- 页签二：单板工位的三台仪器 -->
            <TabItem Header="工位仪器">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,2,4,10"
                              DataContext="{Binding Instruments, RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>

                        <!-- ── 综测仪：供电与电压电流回读 ── -->
                        <Border Style="{StaticResource Style.PanelCard}" Padding="4" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                    <materialDesign:PackIcon Kind="CurrentAc" Width="18" Height="18"
                                                             Foreground="{StaticResource Brush.Primary}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="兆华 CRY5242/5243 四通道电流电压综测仪"
                                                   Style="{StaticResource Style.PanelTitle}"/>
                                        <TextBlock Text="网口 LAN · SCPI 文本指令（四个通道各占一个端口）"
                                                   Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Margin="12,8,12,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启用" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="1" Text="位号" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="2" Text="IP 地址" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="3" Text="端口" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Config.Cry5242Testers}"
                                              ItemTemplate="{StaticResource Template.BoardLanRow}"/>
                                <TextBlock Margin="12,8,12,0" Style="{StaticResource Style.HintWrap}"
                                           Text="端口填通道 A 的端口，B/C/D 依次 +1；清单顺序就是供电槽位顺序，不用的那台取消「启用」。"/>
                                <Expander Margin="12,2,12,6" Header="更多说明" FontSize="11">
                                    <TextBlock Style="{StaticResource Style.HintWrap}" Margin="0,4,0,0"
                                               Text="仪器 IP 由面板拨码开关决定：169.254.1.（32 + 左拨码 ×16 + 右拨码），改完拨码需重启仪器才生效。&#10;电压按 mV（0～6500）、电流按 mA（-2000～+2000）下发；这个电流在 5242 上是过流保护值，只有 5243 是限流值。&#10;线制（四线/二线）在配置文件 FourWire 里填：四线需把 PO+ 与 PO_S+、PO- 与 PO_S- 各自短接。&#10;输出电压、过流保护、斜率时间、回读容差、上电前是否复位也在配置文件里逐台填（OutputMilliVolts / ProtectionMilliAmps / RampMilliSeconds / VoltageToleranceMilliVolts / ResetBeforePowerOn），改完电压要刷新模块库，判定区间跟着它算。"/>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- ── 蓝牙网关：MAC 与信号强度 ── -->
                        <Border Style="{StaticResource Style.PanelCard}" Padding="4" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                    <materialDesign:PackIcon Kind="Bluetooth" Width="18" Height="18"
                                                             Foreground="{StaticResource Brush.Primary}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="研为 EW-DTU09 蓝牙网关"
                                                   Style="{StaticResource Style.PanelTitle}"/>
                                        <TextBlock Text="网口 TCP · AT 指令（广播结果由网关主动上报）"
                                                   Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Margin="12,8,12,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启用" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="1" Text="位号" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="2" Text="IP 地址" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="3" Text="端口" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Config.BluetoothGateways}"
                                              ItemTemplate="{StaticResource Template.BoardLanRow}"/>
                                <TextBlock Margin="12,8,12,0" Style="{StaticResource Style.HintWrap}"
                                           Text="清单顺序就是测试项顺序，只数已启用的行；没接的那几行取消「启用」。"/>
                                <Expander Margin="12,2,12,6" Header="更多说明" FontSize="11">
                                    <TextBlock Style="{StaticResource Style.HintWrap}" Margin="0,4,0,0"
                                               Text="网关侧「数据协议」要选 AT 指令（选 JSON / ModbusTCP / websocket 那几种就不会答 AT），工作模式要停在 AT 指令模式。&#10;端口填网关自己的 TCP 端口，需与网关上位配置一致；本地插网线配参时网关默认 10.10.18.1。&#10;每行可填 ExpectedMac 指定要匹配哪条广播（也支持只填前几个字节）；留空则取识别窗口里信号最强的一条。&#10;单次采信号强度的条数与超时、识别窗口与合格下限（RssiSampleCount / RssiTimeoutMs / IdentifyWindowMs / RssiMinDbm）在 Config\instruments.json 里逐台改，默认 20 条 / 5 秒。"/>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- ── 读码器：产品条码 ── -->
                        <Border Style="{StaticResource Style.PanelCard}" Padding="4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                                    <materialDesign:PackIcon Kind="QrcodeScan" Width="18" Height="18"
                                                             Foreground="{StaticResource Brush.Primary}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="海康 MV-ID 读码器"
                                                   Style="{StaticResource Style.PanelTitle}"/>
                                        <TextBlock Text="网口 TCP · 相机当服务端，触发口发文本、结果口收条码"
                                                   Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Margin="12,8,12,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启用" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="1" Text="位号" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="2" Text="IP 地址" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="3" Text="结果口" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="4" Text="触发口" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="5" Text="触发文本" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="6" Text="交互请求" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <TextBlock Grid.Column="7" Text="交互回复" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Config.BarcodeReaders}"
                                              ItemTemplate="{StaticResource Template.ReaderRow}"/>
                                <TextBlock Margin="12,8,12,0" Style="{StaticResource Style.HintWrap}"
                                           Text="两个端口与两段文本要和相机侧的「TCP 服务器端协议」一致（默认结果口 2002、触发口 2001、文本 start）。"/>
                                <Expander Margin="12,2,12,6" Header="更多说明" FontSize="11">
                                    <TextBlock Style="{StaticResource Style.HintWrap}" Margin="0,4,0,0"
                                               Text="相机侧读码格式按 &lt;回车&gt;&lt;换行&gt;&lt;条码内容&gt;; 推送，一次触发推来几条就读几条。&#10;一台相机一次触发要收几条由 SlotsPerReader 决定（默认 2，只解一个码就改成 1），收不齐会重新触发补扫两轮。&#10;交互两列对应相机侧的「TCP 服务器交互请求/回复文本」（默认 hello / world）；相机没启用交互就把请求列留空。&#10;触发文本默认不补回车换行，要补在配置文件里把 TriggerAppendNewLine 改成 true。&#10;清单顺序就是测试项顺序，只数已启用的行。"/>
                                </Expander>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 按钮行：固定在窗口底部，不跟着内容滚走 -->
        <DockPanel Grid.Row="2" Margin="2,12,2,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Style="{StaticResource Style.SubText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="620" LineHeight="18"/>

            <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource Style.ToolButton}"
                    Margin="10,0,0,0" Click="Close_Click" IsCancel="True"
                    ToolTip="没点保存的改动不会落盘；重新打开这扇窗就是盘上的样子"/>
            <Button DockPanel.Dock="Right" Content="保存" Style="{StaticResource Style.PrimaryButton}"
                    Click="Save_Click"
                    ToolTip="通道信息写进 board-test.json，工位仪器写进 instruments.json；保存即按新配置重建单板页的明细行，本轮已跑结果会一并清空"/>
        </DockPanel>
    </Grid>
</Window>
