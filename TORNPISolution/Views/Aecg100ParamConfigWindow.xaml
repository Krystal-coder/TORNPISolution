<Window x:Class="TORNPISolution.Views.Aecg100ParamConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TORNPISolution.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AECG100参数配置（鲸扬 AECG100）" Width="880" Height="520"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 数字转换器 -->
        <conv:LenientNumberConverter x:Key="LenientNumber"/>

        <!-- 单选组直接绑整数/枚举值 -->
        <conv:ValueEqualsConverter x:Key="ValueEquals"/>

        <!-- 输入框 / 标签 / 分组标题规格统一用 App.xaml  -->
        <Style TargetType="TextBox" BasedOn="{StaticResource Style.CfgBox}"/>

    </Window.Resources>

    <DockPanel>

        <!-- ====== 底部按钮栏 ====== -->
        <Grid DockPanel.Dock="Bottom" Margin="16,10,16,14">
            <TextBlock Text="保存后写入 Config\instruments.json（Aecg100Tester），测试模块按需读取"
                       Style="{StaticResource Style.Hint}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 运行期锁定配置保存：灰显不可点-->
                <TextBlock Text="测试运行中：配置保存已锁定" Foreground="{StaticResource Brush.Fail}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="取消" Style="{StaticResource Style.ToolButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="保存" Style="{StaticResource Style.PrimaryButton}"
                        MinWidth="88" IsEnabled="{Binding CanSave}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ====== 测试参数 ====== -->
        <TabControl Margin="12,10,12,0" Style="{StaticResource Style.NavTabControl}" Background="Transparent" TabStripPlacement="Left"
                    ItemContainerStyle="{StaticResource Style.NavTabItem}">

            <!-- ============ ECG-004 心率测试 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Heart" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="心率测试" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <TextBlock Text="ECG-004 心率检测精度测试参数" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                    </Grid.Resources>
                                    <TextBlock Text="测试点(BPM)"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding HeartRateTestPointsText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="逗号分隔的心率测试点，如 40,60,80,100,120,160"/>
                                    <TextBlock Grid.Column="3" Text="重复次数"/>
                                    <TextBox Grid.Column="4" Width="60" HorizontalAlignment="Left"
                                             Text="{Binding Params.HeartRateRepeats, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="容差(±BPM)" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{StaticResource Brush.Text.Main}" FontSize="12"/>
                                    <TextBox Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding Params.HeartRateTolerance, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Grid.Column="2" Text="每组重复 N 次取最大值，偏差 ≤ 容差为 PASS"
                                               VerticalAlignment="Center" Margin="12,0,0,0" FontSize="10"
                                               Foreground="{StaticResource Brush.Text.Sub}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：每个心率点仪器输出对应频率的 ECG 波形（频率 = BPM/60 Hz），&#10;每组重复 N 次取最大值与设定值比对，误差 ≤ 容差为 PASS。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 噪声 / 阻抗 / 起搏器 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Flash" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="噪声/阻抗/起搏" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- 噪声 -->
                        <TextBlock Text="ECG 噪声" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>
                                <TextBlock Text="幅度(mV)"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Params.NoiseAmplitude, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="最大 2.00 mV"/>
                                <TextBlock Grid.Column="3" Text="频率"/>
                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding NoiseFrequencyOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Key"
                                          SelectedValue="{Binding Params.NoiseFrequency}"/>
                            </Grid>
                        </Border>

                        <!-- 阻抗 -->
                        <TextBlock Text="ECG 阻抗" Style="{StaticResource Style.GroupTitle}"/>
                        <CheckBox Content="启用 620K 阻抗"
                                  IsChecked="{Binding Params.ImpedanceEnabled}"
                                  Margin="0,0,0,6" FontSize="12"/>

                        <!-- 起搏器 -->
                        <TextBlock Text="起搏脉冲" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <StackPanel>
                                <CheckBox Content="启用起搏脉冲输出"
                                          IsChecked="{Binding Params.PacingEnabled}"
                                          Margin="0,0,0,8" FontSize="12"/>
                                <Grid IsEnabled="{Binding Params.PacingEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                    </Grid.Resources>
                                    <TextBlock Text="幅度(mV)"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Params.PacingAmplitude, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Grid.Column="3" Text="持续(ms)"/>
                                    <TextBox Grid.Column="4"
                                             Text="{Binding Params.PacingDuration, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Grid.Row="2" Text="速率(BPM)"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding Params.PacingRate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 呼吸调制 -->
                        <TextBlock Text="ECG 呼吸调制（Respiration）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>
                                <TextBlock Text="呼吸模式"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding RespirationModeOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Key"
                                          SelectedValue="{Binding Params.DefaultRespirationMode}"/>
                                <TextBlock Grid.Column="3" Text="速率(BrPM)"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.DefaultRespirationRate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="2" Text="幅度(milli-ohm)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.DefaultRespirationAmplitude, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="仅阻抗式呼吸有效，1000~5000（1.0~5.0 ohm）"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="比率"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.DefaultRespirationRatio, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="阻抗式 1~5（1:1~1:5）；调制式为 -16~16 变化量"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ECG-009 动态范围和线性（A10 唯一实现项） ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Waves" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ECG-009动态范围" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <TextBlock Text="仪器输出" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                    </Style>
                                </Grid.Resources>

                                <!-- 幅度/偏置档 -->
                                <TextBlock Text="幅度档(mV)"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Ecg009AmplitudesText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="逗号分隔的峰-谷幅度档，法规值 0.5,1,2,10"/>
                                <TextBlock Grid.Column="3" Text="偏置档(mV)"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Ecg009DcOffsetsText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="逗号分隔的 DC 偏置档，法规值 0,300,-300"/>

                                <TextBlock Grid.Row="2" Text="波形频率(Hz)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.Ecg009Frequency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="法规 6.25Hz（160ms 一周期）"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="噪声频率"/>
                                <ComboBox Grid.Row="2" Grid.Column="4" Height="26" VerticalContentAlignment="Center"
                                          SelectedIndex="{Binding Params.Ecg009NoiseFrequency}"
                                          ToolTip="噪声发生器频率；法规要求 Off，勾了噪声会叠加在波形上影响幅值判定">
                                    <ComboBoxItem Content="Off（关）"/>
                                    <ComboBoxItem Content="50Hz"/>
                                    <ComboBoxItem Content="60Hz"/>
                                    <ComboBoxItem Content="100Hz"/>
                                    <ComboBoxItem Content="120Hz"/>
                                </ComboBox>

                                <TextBlock Grid.Row="4" Text="电极"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal">
                                    <RadioButton Content="RA/R"
                                                 IsChecked="{Binding Params.Ecg009Electrode, Converter={StaticResource ValueEquals}, ConverterParameter=0, Mode=TwoWay}"
                                                 ToolTip="右臂输出"/>
                                    <RadioButton Content="LA/L"
                                                 IsChecked="{Binding Params.Ecg009Electrode, Converter={StaticResource ValueEquals}, ConverterParameter=255, Mode=TwoWay}"
                                                 ToolTip="左臂输出"/>
                                </StackPanel>

                                <TextBlock Grid.Row="6" Text="波形"/>
                                <WrapPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4">
                                    <RadioButton Content="三角波"
                                                 IsChecked="{Binding Params.Ecg009WaveformType, Converter={StaticResource ValueEquals}, ConverterParameter=1, Mode=TwoWay}"
                                                 ToolTip="Triangle，法规要求本项用三角波"/>
                                    <RadioButton Content="正弦波"
                                                 IsChecked="{Binding Params.Ecg009WaveformType, Converter={StaticResource ValueEquals}, ConverterParameter=0, Mode=TwoWay}"/>
                                    <RadioButton Content="方波"
                                                 IsChecked="{Binding Params.Ecg009WaveformType, Converter={StaticResource ValueEquals}, ConverterParameter=2, Mode=TwoWay}"/>
                                    <RadioButton Content="矩形脉冲"
                                                 IsChecked="{Binding Params.Ecg009WaveformType, Converter={StaticResource ValueEquals}, ConverterParameter=3, Mode=TwoWay}"/>
                                    <RadioButton Content="三角脉冲"
                                                 IsChecked="{Binding Params.Ecg009WaveformType, Converter={StaticResource ValueEquals}, ConverterParameter=4, Mode=TwoWay}"/>
                                    <RadioButton Content="ECG"
                                                 IsChecked="{Binding Params.Ecg009WaveformType, Converter={StaticResource ValueEquals}, ConverterParameter=6, Mode=TwoWay}"/>
                                </WrapPanel>

                                <TextBlock Grid.Row="8" Text="620kΩ 阻抗"/>
                                <CheckBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="4" Content="串入 620kΩ 输入阻抗（不勾＝短路，直接输出）"
                                          IsChecked="{Binding Params.Ecg009Impedance}" FontSize="12" VerticalAlignment="Center"
                                          ToolTip="只作用于本项各档位的输出，不受“噪声/阻抗/起搏”页里的勾选影响"/>

                                <TextBlock Grid.Row="10" Grid.ColumnSpan="5" Style="{StaticResource Style.Hint}" TextWrapping="Wrap"
                                           Text="脉冲宽度固定 100ms"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="串口采集与判定" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Text="丢弃前(s)"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Params.Ecg009DiscardSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="仪器开始输出后，避开刚进入心电测量的起始瞬态"/>
                                <TextBlock Grid.Column="3" Text="有效采集(s)"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.Ecg009RecordSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="丢弃段之后连续记录这么多秒用于判定（默认 20+60 即取 20s~80s 这段）；采完立刻停输出进下一档"/>

                                <TextBlock Grid.Row="2" Text="换档等待(ms)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.Ecg009StepDelayMs, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="停输出→下一档开始输出之间的等待"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="允差分界(mV)"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.Ecg009ToleranceSplitMv, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="分段判定的分界幅度：≤本值的档用绝对允差，>本值的档用百分比允差（默认 2）"/>

                                <TextBlock Grid.Row="4" Text="分界内允差(μV)"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding Params.Ecg009ToleranceFloorUv, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="默认 50：0.5/1/2mV 这类小幅度档按绝对值判，判 |回读波峰-波谷−设定| ≤ 本值"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="分界外允差(%)"/>
                                <TextBox Grid.Row="4" Grid.Column="4"
                                         Text="{Binding Params.Ecg009TolerancePercent, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"
                                         ToolTip="默认 10：10mV 这类大幅度档按相对值判，判 |回读波峰-波谷−设定| ≤ 设定×本百分比"/>

                                <TextBlock Grid.Row="6" Grid.ColumnSpan="5" Style="{StaticResource Style.Hint}" TextWrapping="Wrap"
                                           Text="判定量 = 波峰-波谷，忽略单点毛刺"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：一个幅度跑完 0/300/-300 三个偏置为一轮，共 12 项。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 频率扫描 / DC 偏置 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tune" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="频率扫描/DC偏置" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- 频率扫描 -->
                        <TextBlock Text="频率扫描参数" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>
                                <TextBlock Text="幅度(mV)"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Params.FrequencyScanAmplitude, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Column="3" Text="时长(s)"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.FrequencyScanDuration, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="2" Text="起始(Hz)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.FrequencyScanStart, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="终止(Hz)"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.FrequencyScanFinish, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </Grid>
                        </Border>

                        <!-- DC 偏置 -->
                        <TextBlock Text="DC 偏置" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>
                                <CheckBox Content="可变偏置模式（-500~500mV）"
                                          IsChecked="{Binding Params.DCOffsetVariable}"
                                          Grid.ColumnSpan="2"/>
                                <TextBlock Grid.Column="3" Text="偏置(mV)"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.DCOffset, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：偏置 300/0/-300 mV "/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ PPG 心率（PPG-1R-525 绿光模块） ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartFlash" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="PPG心率" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <TextBlock Text="PPG-001 脉搏率精度（需 PPG-1R-525 绿光模块在位）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>
                                <TextBlock Text="测试点(BPM)"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding PpgHeartRateTestPointsText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="逗号分隔的 PPG 心率测试点，如 60,80,100,120"/>
                                <TextBlock Grid.Column="3" Text="每档重复"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.PpgHeartRateRepeats, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="2" Text="容差(±BPM)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.PpgHeartRateTolerance, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="采集时长(ms)"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.PpgCaptureTimeMs, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="PPG 波形参数（WTQOutputPPG 输出时使用）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>
                                <TextBlock Text="直流分量(mV)"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Params.PpgVolDC, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Column="3" Text="主波幅度(mV)"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.PpgVolSP, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="2" Text="重搏切迹(mV)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.PpgVolDN, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="重搏波(mV)"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.PpgVolDP, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="4" Text="主波时刻(ms)"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding Params.PpgTimeSP, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="切迹时刻(ms)"/>
                                <TextBox Grid.Row="4" Grid.Column="4"
                                         Text="{Binding Params.PpgTimeDN, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="6" Text="重搏波时刻(ms)"/>
                                <TextBox Grid.Row="6" Grid.Column="1"
                                         Text="{Binding Params.PpgTimeDP, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：仪器经绿光 LED 输出 PPG 波形（频率 = BPM/60 Hz），产品光学传感器接收后计算心率，&#10;回读 0x7C 与设定值比对；测试前自动检测 PPG-1R-525 模块是否在位，不在位直接判 FAIL。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ SpO2 血氧（PPG-2R-940 红+红外模块） ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="WaterPercent" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="SpO2血氧" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <TextBlock Text="SPO2-004~006 精度检测（需 PPG-2R-940 红光+红外模块在位）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>
                                <TextBlock Text="血氧测试点(%)"
                                           ToolTip="SPO2-004 血氧饱和度精度测试点，逗号分隔，如 75,80,90,95,100"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Spo2TestPointsText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="逗号分隔的 SpO2 测试点，如 75,80,90,95,100"/>
                                <TextBlock Grid.Column="3" Text="脉搏率(BPM)"
                                           ToolTip="SPO2-004/006 血氧点测试时使用的固定脉搏率"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.Spo2PulseRate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="2" Text="SpO2容差(±%)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.Spo2Tolerance, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="脉搏率容差(±BPM)"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.Spo2PulseRateTolerance, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="4" Text="采集时长(ms)"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding Params.Spo2CaptureTimeMs, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="参考血氧(%)"
                                           ToolTip="SPO2-005 脉搏率测试与 A12 测量信号使用的固定血氧设定值"/>
                                <TextBox Grid.Row="4" Grid.Column="4"
                                         Text="{Binding Params.Spo2PulseRateRefSpo2, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="6" Text="脉搏率测试点(BPM)"
                                           ToolTip="SPO2-005 脉搏率精度测试点，逗号分隔，如 40,60,80,100,120,160"/>
                                <TextBox Grid.Row="6" Grid.Column="1"
                                         Text="{Binding Spo2PulseRateTestPointsText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="逗号分隔的脉搏率测试点，如 40,60,80,100,120,160"/>
                                <TextBlock Grid.Row="6" Grid.Column="3" Text="低氧测试点(%)"
                                           ToolTip="SPO2-006 低氧范围精度测试点，逗号分隔，如 50,60,70"/>
                                <TextBox Grid.Row="6" Grid.Column="4"
                                         Text="{Binding Spo2LowRangeTestPointsText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="逗号分隔的低氧测试点，如 50,60,70"/>

                                <TextBlock Grid.Row="8" Text="低氧容差(±%)"/>
                                <TextBox Grid.Row="8" Grid.Column="1"
                                         Text="{Binding Params.Spo2LowRangeTolerance, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="标定曲线与通道参数（SpO2 = A - B×R）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>
                                <TextBlock Text="系数 A"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Params.Spo2CalibrationA, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Column="3" Text="系数 B"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.Spo2CalibrationB, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="2" Text="红外AC(mV)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.Spo2IrAcAmplitude, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="双通道DC(mV)"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.Spo2VolDC, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：按产品标定曲线 SpO2 = A - B×R 反解 R=(AC红/DC红)/(AC红外/DC红外)，红外 AC 固定、红光 AC 按 R 比例计算，&#10;双通道同步输出（WTQOutputPPGEx）；A/B 系数需按产品实际标定曲线校准。测试前自动检测 PPG-2R-940 模块是否在位。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ LED 校准 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LightbulbOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="LED校准" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <TextBlock Text="PPG LED 校准参数（WritePpgLedLevel / WritePpgTriggerLevel）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="红光 LED Level" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.LedCalibration.RedLedLevel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="0~255（默认 128）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="红光 Trigger Level" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.LedCalibration.RedTriggerLevel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="0~255（默认 128）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="红外 LED Level" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.LedCalibration.IrLedLevel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="0~255（默认 128）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="红外 Trigger Level" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.LedCalibration.IrTriggerLevel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="0~255（默认 128）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="绿光 LED Level" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.LedCalibration.GreenLedLevel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="0~255（默认 128）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="绿光 Trigger Level" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.LedCalibration.GreenTriggerLevel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="0~255（默认 128）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：保存后写入 instruments.json（Aecg100Tester.LedCalibration），&#10;LED校准模块执行时读取并调用 WTQWritePPGLedCalibrationSetting / WTQWritePPGTriggerLevelCalibrationSetting。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ECG 默认波形参数 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartPulse" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ECG 波形参数" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <TextBlock Text="ECG 默认波形参数（WTQOutputECG 输出时使用）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>

                                <TextBlock Text="波形类型"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding EcgWaveformTypes}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Key"
                                          SelectedValue="{Binding Params.DefaultWaveformType}"/>

                                <TextBlock Grid.Column="3" Text="输出电极"/>
                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding ElectrodeOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Key"
                                          SelectedValue="{Binding Params.DefaultElectrode}"/>

                                <TextBlock Grid.Row="2" Text="幅度(mV)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.DefaultAmplitude, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="2" Grid.Column="3" Text="周期(ms)"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.DefaultTimePeriod, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="4" Text="P波(mV)"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding Params.DefaultPWave, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="4" Grid.Column="3" Text="T波(mV)"/>
                                <TextBox Grid.Row="4" Grid.Column="4"
                                         Text="{Binding Params.DefaultTWave, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="6" Text="ST段(mV)"/>
                                <TextBox Grid.Row="6" Grid.Column="1"
                                         Text="{Binding Params.DefaultSTSegment, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="6" Grid.Column="3" Text="脉冲宽(ms)"/>
                                <TextBox Grid.Row="6" Grid.Column="4"
                                         Text="{Binding Params.DefaultPulseWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </Grid>
                        </Border>

                        <!-- ECG 间期参数 -->
                        <TextBlock Text="ECG 间期参数" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CfgLabel}"/>
                                </Grid.Resources>

                                <TextBlock Text="PR间期(ms)"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Params.DefaultPRInterval, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Column="3" Text="QRS宽度(ms)"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Params.DefaultQRSDuration, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>

                                <TextBlock Grid.Row="2" Text="T波宽度(ms)"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Params.DefaultTDuration, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="QT间期(ms)"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding Params.DefaultQTInterval, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
