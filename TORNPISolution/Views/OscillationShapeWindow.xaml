<Window x:Class="TORNPISolution.Views.OscillationShapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TORNPISolution.Views"
        Title="Oscillation Shape（包络曲线配置）" Width="900" Height="740"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- 参数行标签 -->
        <Style x:Key="Style.RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="160"/>
        </Style>
        <!-- 参数行数值框 -->
        <Style x:Key="Style.RowBox" TargetType="TextBox">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <!-- 分组标题 -->
        <Style x:Key="Style.GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <!-- 图例条目文字 -->
        <Style x:Key="Style.LegendText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- 底部按钮栏 -->
        <Grid DockPanel.Dock="Bottom" Margin="16,10,16,14">
            <TextBlock Text="确定后参数写回动态血压 Customized 配置，随血压仪参数配置页一起保存"
                       VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource Brush.Text.Sub}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Style.ToolButton}" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="确定" Style="{StaticResource Style.PrimaryButton}" MinWidth="88"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>

        <Grid Margin="14,10,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="215"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 包络曲线预览 + 右侧图例 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <views:OscillationShapeChart x:Name="ShapeChart" Params="{Binding Model}"/>

                <!-- 图例：与图上标记配色一一对应 -->
                <StackPanel Grid.Column="1" Margin="14,10,0,0">
                    <TextBlock Text="图例" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{StaticResource Brush.Text.Sub}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="9" Height="9" Fill="#FF8E24AA" VerticalAlignment="Center"/>
                        <TextBlock Text="Max Pulse 2" Style="{StaticResource Style.LegendText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="9" Height="9" Fill="#FFD81B60" VerticalAlignment="Center"/>
                        <TextBlock Text="Max Pulse 1" Style="{StaticResource Style.LegendText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="9" Height="9" Fill="#FF1565C0" VerticalAlignment="Center"/>
                        <TextBlock Text="SYS Rate" Style="{StaticResource Style.LegendText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="9" Height="9" Fill="#FF43A047" VerticalAlignment="Center"/>
                        <TextBlock Text="DIAS Rate" Style="{StaticResource Style.LegendText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="9" Height="9" Fill="#FFFF9800" VerticalAlignment="Center"/>
                        <TextBlock Text="Offset" Style="{StaticResource Style.LegendText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="9" Height="9" Fill="White" Stroke="#FF9E9E9E" StrokeThickness="1.5" VerticalAlignment="Center"/>
                        <TextBlock Text="SP2 / SP1" Style="{StaticResource Style.LegendText}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 参数区：x 轴八点（左）+ y 轴五点比率（右） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <StackPanel>

                    <TextBlock Text="X 轴（mmHg 0~299）：须满足 SP2 &gt; PS &gt; SYS &gt; MAP2 &gt; MAP1 &gt; DIAS &gt; PD &gt; SP1"
                               Style="{StaticResource Style.GroupTitle}" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding OrderWarning}" FontSize="11" Foreground="#FFD32F2F" Margin="2,0,0,4"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- X 轴八点：SYS/DIAS 即动态血压页的收缩压/舒张压（BPCommon Header） -->
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="包络点 2（SP2）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="299"
                                            Value="{Binding SettingPoint2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding SettingPoint2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="mmHg" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起始压力（PS）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="299"
                                            Value="{Binding StartPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding StartPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="mmHg" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="收缩压（SYS）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="300"
                                            Value="{Binding Systolic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding Systolic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="mmHg" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="平均动脉压 2（MAP2）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="299"
                                            Value="{Binding MeanArterialPressure2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding MeanArterialPressure2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="mmHg" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="平均动脉压 1（MAP1）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="299"
                                            Value="{Binding MeanArterialPressure1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding MeanArterialPressure1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="mmHg" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="舒张压（DIAS）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="250"
                                            Value="{Binding Diastolic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding Diastolic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="mmHg" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="结束压力（PD）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="299"
                                            Value="{Binding EndPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding EndPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="mmHg" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="包络点 1（SP1）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="299"
                                            Value="{Binding SettingPoint1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding SettingPoint1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="3" Text="mmHg" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12,6">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="#FFFF9800" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="偏移比率（Offset）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding OffsetRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding OffsetRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="4" Text="%" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="#FF1565C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="收缩压比率（SYS Rate）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding SystolicRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding SystolicRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="4" Text="%" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="#FF8E24AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="平均动脉压比率 2 (Max Pulse 2)" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding MeanAriterialRate2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding MeanAriterialRate2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="4" Text="%" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="#FFD81B60" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="平均动脉压比率 1 (Max Pulse 1)" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding MeanAriterialRate1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding MeanAriterialRate1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="4" Text="%" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="#FF43A047" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="舒张压比率（DIAS Rate）" Style="{StaticResource Style.RowLabel}"/>
                                    <Slider Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding DiastolicRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource Style.RowBox}"
                                             Text="{Binding DiastolicRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="4" Text="%" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
