<UserControl x:Class="TORNPISolution.Views.EcgCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TORNPISolution.ViewModels"
             xmlns:views="clr-namespace:TORNPISolution.Views"
             mc:Ignorable="d"
             FontFamily="Microsoft YaHei UI"
             d:DataContext="{d:DesignInstance Type=viewModels:EcgCaptureViewModel}"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <!-- 工况条按钮：与加速度充电检查同一档（蓝底、左右内边距 8），一整排并下来宽度才稳 -->
        <Style x:Key="Style.BarButton" TargetType="Button" BasedOn="{StaticResource Style.PrimaryButton}">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头：串口从哪来一句话交代清楚，参数不在这里配 -->
        <Border Grid.Row="0" Style="{StaticResource Style.PanelCard}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ECG 波形采集" Style="{StaticResource Style.PanelTitle}"/>
                    <TextBlock Style="{StaticResource Style.SubText}" Margin="0,4,0,0" Text="{Binding PortText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="连接" Command="{Binding ConnectCommand}" Style="{StaticResource Style.PrimaryButton}"
                            ToolTip="串口参数取「配置→被测产品」；连上即代产品进入产测态（产品上口后 20 秒内有效）"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}" Style="{StaticResource Style.ToolButton}"
                            Margin="8,0,0,0"
                            ToolTip="先点「停止采集」再断开：断开会自动停推流、退出产测、把内存里这段落完盘再交出口"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工况条：采集 / 分段与数据 / 计数。三段定宽，计数吃剩余空间，数字变长不会把键顶到下一行 -->
        <Border Grid.Row="1" Style="{StaticResource Style.PanelCard}" Margin="0,8,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0" ToolTip="开始/停止只动产品的推流开关，串口保持连接；要回整机页得先点「断开」">
                    <TextBlock Text="采集" Style="{StaticResource Style.FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="开始采集" Command="{Binding StartCaptureCommand}" Style="{StaticResource Style.BarButton}"/>
                        <Button Content="停止采集" Command="{Binding StopCaptureCommand}" Style="{StaticResource Style.BarButton}"
                                Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Text="分段与数据" Style="{StaticResource Style.FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="另起一段" Command="{Binding NewSegmentCommand}" Style="{StaticResource Style.BarButton}"
                                ToolTip="上一段先落盘，时间轴与序号回到 0，滚动 CSV 另开一份——换一个姿态或换一个导联就点这颗"/>
                        <Button Content="导出当前" Command="{Binding ExportCommand}" Style="{StaticResource Style.BarButton}"
                                Margin="6,0,0,0" ToolTip="把内存里这一段另存一份 CSV（滚动文件照常继续）"/>
                        <Button Content="打开目录" Command="{Binding OpenFolderCommand}" Style="{StaticResource Style.BarButton}"
                                Margin="6,0,0,0"/>
                        <Button Content="清空显示" Command="{Binding ClearDisplayCommand}" Style="{StaticResource Style.BarButton}"
                                Margin="6,0,0,0" ToolTip="丢掉内存里的波形，不落盘；要留数据就先点「导出当前」"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding SummaryText}" Style="{StaticResource Style.SubText}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- 两路波形：同一份采样缓冲的两个视图，横轴对齐，各调各的纵轴与窗口 -->
        <views:EcgTracePanel Grid.Row="2" DataContext="{Binding Adc}" Margin="0,8,0,0"/>
        <views:EcgTracePanel Grid.Row="3" DataContext="{Binding Millivolts}" Margin="0,8,0,0"/>

        <Border Grid.Row="4" Style="{StaticResource Style.PanelCard}" Margin="0,8,0,0" Padding="14,8">
            <StackPanel>
                <TextBlock Style="{StaticResource Style.Hint}" TextWrapping="Wrap" Text="{Binding HintText}"/>
                <!-- 路径整句换行显示，不做省略：WPF 的 TextTrimming 只有尾省略，砍掉的正好是要看的文件名 -->
                <TextBlock Style="{StaticResource Style.SubText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding CsvText}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
