<Window x:Class="TORNPISolution.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TORNPISolution.Views"
        xmlns:conv="clr-namespace:TORNPISolution.Converters"
        xmlns:models="clr-namespace:TORNPISolution.Share.Models;assembly=TORNPISolution.Share"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dd="urn:gong-wpf-dragdrop"
        mc:Ignorable="d"
        Icon="/Images/logo.ico"
        FontFamily="Microsoft YaHei UI"
        Title="TOR NPI Solution" Height="720" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- 明细表 -->
        <Style x:Key="Style.DetailGroup" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ToggleButton x:Name="GroupHeader" IsChecked="True" Focusable="False"
                                          Background="#EEF2F7" BorderBrush="{StaticResource Brush.Panel.Border}"
                                          BorderThickness="0,0,0,1" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" Padding="8,5">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="Chevron" Kind="ChevronDown"
                                                                         Width="16" Height="16" VerticalAlignment="Center"
                                                                         Foreground="#5A6B7B"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#2F3E4E"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 项}" FontSize="11"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5A6B7B"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E4EAF1"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="Kind" Value="ChevronRight"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ItemsPresenter x:Name="GroupBody"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="GroupHeader" Property="IsChecked" Value="False">
                                <Setter TargetName="GroupBody" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Name}" Value="">
                                <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.ModuleResultBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#EEF1F5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModuleResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Background" Value="#E6F4EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ModuleResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Background" Value="#FDECEC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.ModuleResultBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModuleResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ModuleResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 右侧明细面板的模块结果 -->
        <Style x:Key="Style.DetailResultBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#EEF1F5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPlanModule.ModuleResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Background" Value="#E6F4EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedPlanModule.ModuleResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Background" Value="#FDECEC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.DetailResultBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPlanModule.ModuleResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedPlanModule.ModuleResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 整体方案结果徽章（PASS / NG / 未测试） -->
        <Style x:Key="Style.PlanResultBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#EEF1F5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlanResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Background" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PlanResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Background" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.PlanResultBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlanResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PlanResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryHueMidBrush}"
                Padding="10,5,14,5">
            <Grid>
                <Menu HorizontalAlignment="Left" VerticalAlignment="Center"
                      Style="{StaticResource MaterialDesignMenu}" Background="Transparent">
                    <Menu.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                            <Setter Property="Padding" Value="0,0,0,0"/>
                        </Style>
                    </Menu.ItemContainerStyle>

            <!-- 文件菜单 -->
                    <MenuItem Header="文件" Style="{StaticResource MaterialDesignMenuItem}" Height="30">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="15" Height="15" Margin="0"/>
                        </MenuItem.Icon>
                        <MenuItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="-20,0,0,0"/>
                            </DataTemplate>
                        </MenuItem.HeaderTemplate>
                        <MenuItem Header="保存方案" Click="MenuSavePlan_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                        <MenuItem Header="加载方案" Click="MenuLoadPlan_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                        <MenuItem Header="历史数据" Click="MenuHistory_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                        <Separator/>
                        <MenuItem Header="退出" Click="MenuExit_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                    </MenuItem>

            <!-- 配置菜单 -->
                    <MenuItem Header="配置" Style="{StaticResource MaterialDesignMenuItem}" Height="30">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="CogOutline" Width="15" Height="15" Margin="0"/>
                        </MenuItem.Icon>
                        <MenuItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="-20,0,0,0"/>
                            </DataTemplate>
                        </MenuItem.HeaderTemplate>
                        <MenuItem Header="仪器链接配置" Click="MenuInstrumentConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                        <MenuItem Header="单板配置" Click="MenuBoardConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"
                                  ToolTip="八条路各自的位号与跑不跑，以及单板工位的综测仪/蓝牙网关/读码器；本轮跑哪几项在旁边的「测试项」里勾"/>
                        <MenuItem Header="烧录配置" Click="MenuFlashingConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"
                                  ToolTip="SPI Flash 烧录器与富芮坤主控工具的参数（所有通道共用），以及八条通道各走哪个口"/>
                        <MenuItem Header="血压模拟仪测试配置" Click="MenuBpaParamConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                        <MenuItem Header="AECG100参数配置" Click="MenuAecg100ParamConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                    </MenuItem>

                     <!-- 通讯配置菜单 -->
                    <MenuItem Header="通讯协议" Style="{StaticResource MaterialDesignMenuItem}" Height="30">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Protocol" Width="15" Height="15" Margin="0"/>
                        </MenuItem.Icon>
                        <MenuItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="-20,0,0,0"/>
                            </DataTemplate>
                        </MenuItem.HeaderTemplate>
                        <MenuItem Header="协议命令配置" Click="MenuProtocolCommandConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                    </MenuItem> 

                    <MenuItem Header="测试项" Click="MenuBoardTestItems_Click"
                          Style="{StaticResource MaterialDesignMenuItem}" Height="30"
                          ToolTip="勾选单板工位本轮要跑的测试项（所有通道共用同一组，勾选项存在 board-test.json）">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FormatListChecks" Width="15" Height="15" Margin="0"/>
                        </MenuItem.Icon>
                        <MenuItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="-20,0,0,0"/>
                            </DataTemplate>
                        </MenuItem.HeaderTemplate>
                    </MenuItem>
                </Menu>

                <!-- 顶栏右侧操作：加载方案（仅整机页显示）+ 返回工位选择 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding LoadPlanCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsWholeMachinePage, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="从磁盘加载已保存的测试方案（文件菜单里也有）"
                            Style="{StaticResource Style.ToolButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="加载方案" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="← 返回工位选择" Command="{Binding BackToEntryCommand}"
                            Style="{StaticResource Style.ToolButton}"
                            Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="回到工位选择页（任一工位正在跑时不可点）"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Margin="12">
        <views:WorkbenchEntryView Visibility="{Binding IsEntryPage, Converter={StaticResource BoolToVisibility}}"/>

        <Grid Visibility="{Binding IsWholeMachinePage, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏：测试模块库（可收缩） -->
        <Grid Grid.Column="0">

            <!-- 收起态：窄条，点击展开 -->
            <Border Width="30" Cursor="Hand"
                    MouseLeftButtonUp="LibraryStrip_MouseLeftButtonUp"
                    ToolTip="展开测试模块库">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Style.PanelCard}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="»" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Primary}"/>
            </Border>

            <!-- 展开完整模块库 -->
            <Border Width="250" Style="{StaticResource Style.PanelCard}"
                    Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 面板标题 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LibraryTitleText}" Style="{StaticResource Style.PanelTitle}"/>
                            <TextBlock Text="拖拽或双击模块"
                                       Style="{StaticResource Style.SubText}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="«" FontSize="14" FontWeight="Bold"
                                Width="26" Height="26" Padding="0" VerticalAlignment="Top"
                                Style="{StaticResource Style.ToolButton}" Margin="0"
                                ToolTip="收起模块库"
                                Command="{Binding ToggleLibraryCommand}"/>
                    </Grid>

                    <ListBox x:Name="LibraryList" Grid.Row="1"
                             ItemsSource="{Binding LibraryModules}"
                             BorderThickness="0" Background="Transparent"
                             Margin="8,0,8,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             dd:DragDrop.IsDragSource="True"
                             MouseDoubleClick="LibraryList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="2,3"/>
                                <Setter Property="Cursor" Value="SizeAll"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#F8FAFC"
                                                    BorderBrush="{StaticResource Brush.Panel.Border}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Primary.Light}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⠿" FontSize="14" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{StaticResource Brush.Text.Main}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Style.SubText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ItemCountText}"
                                               Style="{StaticResource Style.SubText}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="该工位还没有测试模块&#10;在 Spec 目录里声明一项就会显示在这里"
                               Style="{StaticResource Style.SubText}" TextAlignment="Center" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="16,0"
                               Visibility="{Binding HasLibraryModules, Converter={StaticResource InverseBoolToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 中栏：测试方案 -->
        <Border Grid.Column="2" Style="{StaticResource Style.PanelCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding PlanTitleText}" Style="{StaticResource Style.PanelTitle}"/>
                            <TextBlock Text="{Binding PlanSummaryText}" Style="{StaticResource Style.SubText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Style.PlanResultBadge}"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding PlanResultText}" Style="{StaticResource Style.PlanResultBadgeText}"/>
                    </Border>
                    <Button Grid.Column="2" Content="清空" Style="{StaticResource Style.ToolButton}"
                            VerticalAlignment="Center" Command="{Binding ClearPlanCommand}"/>
                </Grid>

                <!-- 方案模块列表 -->
                <ListBox x:Name="PlanList" Grid.Row="1"
                         ItemsSource="{Binding PlanModules}"
                         SelectionChanged="PlanList_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         Margin="8,0,8,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         dd:DragDrop.DropHandler="{Binding}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="#F8FAFC"
                                                BorderBrush="{StaticResource Brush.Panel.Border}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Primary.Light}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource Brush.Primary}" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Sequence}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="{StaticResource Brush.Text.Main}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Style.SubText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 模块结果徽章 -->
                                <Border Grid.Column="2" Style="{StaticResource Style.ModuleResultBadge}"
                                        VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock Text="{Binding ModuleResultText}"
                                               Style="{StaticResource Style.ModuleResultBadgeText}"/>
                                </Border>

                                <Button Grid.Column="3" Content="✕" FontSize="11" Width="24" Height="24"
                                        Padding="0" Margin="4,0,0,0" Cursor="Hand"
                                        dd:DragDrop.DragSourceIgnore="True"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource Brush.Text.Sub}"
                                        ToolTip="从方案中移除"
                                        Command="{Binding DataContext.RemoveFromPlanCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空方案提示 -->
                <TextBlock Grid.Row="1" Text="将左侧模块拖到这里&#10;组建你的测试方案"
                           TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Sub}" FontSize="13" LineHeight="22"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlanModules.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                    <!-- 方案操作区：重试保存（仅入库失败时出现）/ 导出报告（导PDF，数据已自动入库）/ 复位结果 / 运行方案；保存与加载方案只在文件菜单 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="14,6,14,12">
                        <!-- 只在入库失败滞留时出现：把仍留在内存里的本轮数据补存进库 -->
                        <Button Command="{Binding RetrySaveCommand}" Margin="0,0,8,0"
                            ToolTip="上一轮入库失败后出现：把仍留在内存里的这轮数据补存进库（开新一轮会被覆盖）">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Style.ToolButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingSave}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Foreground="#FFEF5350"/>
                                <TextBlock Text="重试保存" VerticalAlignment="Center" Foreground="#FFEF5350"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Style.ToolButton}"
                            Command="{Binding SaveReportCommand}" Margin="0,0,8,0"
                            ToolTip="导出本轮测试报告（PDF）——方案跑完自动入库后才可点">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="导出报告" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="复位结果" Style="{StaticResource Style.ToolButton}"
                            Command="{Binding ResetPlanCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Style.PrimaryButton}"
                            Command="{Binding RunOrStopCommand}">
                        <!-- 空闲时"运行方案"，运行中变"停止" -->
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▶ 运行方案"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="■ 停止"/>
                                            <Setter Property="Foreground" Value="#FFC62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右栏：模块测试明细 -->
        <Border Grid.Column="4" Style="{StaticResource Style.PanelCard}">
            <Grid>
                <!-- 未选中模块时的占位提示 -->
                <TextBlock Text="点击中间方案列表中的模块&#10;查看测试内容、规格与测试值" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Sub}" FontSize="13" LineHeight="22">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedPlanModule}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 明细内容 -->
                <Grid Visibility="{Binding HasSelectedPlanModule, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,12,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedPlanModule.Name}" Style="{StaticResource Style.PanelTitle}"/>
                            <TextBlock Text="{Binding SelectedPlanModule.Description}"
                                       Style="{StaticResource Style.SubText}" Margin="0,4,0,0"/>
                        </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Style.ToolButton}" Margin="0,0,8,0"
                                    Click="OpenWaveformOverview_Click"
                                    Visibility="{Binding ShowOverviewWaveformButton, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="打开本模块的ECG Signal窗口：各档位曲线按时间轴首尾相接成一张长图，设定侧与回读侧同图两条曲线（可缩放/平移/最大化）">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartLine" Width="14" Height="14"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="波形窗口" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Border Style="{StaticResource Style.DetailResultBadge}">
                                <TextBlock Text="{Binding SelectedPlanModule.ModuleResultText}"
                                           Style="{StaticResource Style.DetailResultBadgeText}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 测试项明细表：测试内容 / 规格 / 测试值 / 结果 -->
                        <DataGrid x:Name="DetailGrid" Grid.Row="1" Margin="10,0,10,12"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              RowDetailsVisibilityMode="Visible"
                              EnableRowVirtualization="False" EnableColumnVirtualization="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Brush.Panel.Border}"
                              Background="Transparent" BorderThickness="0"
                              RowHeight="36" FontSize="12"
                              SelectionMode="Single" SelectionUnit="FullRow">

                            <DataGrid.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource Style.DetailGroup}"/>
                            </DataGrid.GroupStyle>

                            <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <StackPanel Visibility="{Binding HasRowDetails, Converter={StaticResource BoolToVisibility}}">

                                <Border Margin="8,2,8,4" CornerRadius="6" Padding="12,6"
                                        Background="{StaticResource Brush.Panel.Background}"
                                        BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                        Visibility="{Binding HasPointResults, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Resources>
                                                <Style x:Key="Style.SubTableHead" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LeftAlign}" Value="True">
                                                    <Setter Property="TextAlignment" Value="Left"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>

                                        <Style x:Key="Style.SubTableCell" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LeftAlign}" Value="True">
                                                    <Setter Property="TextAlignment" Value="Left"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="pass">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="fail">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="stat">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="sub">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="bold">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Resources>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <materialDesign:PackIcon Kind="FormatListChecks" Width="14" Height="14"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource Brush.Primary}"/>
                                            <TextBlock Text="{Binding PointTableTitle}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource Brush.Text.Main}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>

                                            <TextBlock Text="{Binding PointSummaryText}" FontSize="11"
                                                       Foreground="{StaticResource Brush.Text.Sub}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <!-- 列头与数据行都按列定义给固定像素宽（表头与单元格同值），窄窗口下横向滚动 -->
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding SubTableColumns}" Margin="0,0,0,2">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Header}" Width="{Binding Width}"
                                                                       Style="{StaticResource Style.SubTableHead}"
                                                                       ToolTip="{Binding Header}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding SubTableRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ItemsControl ItemsSource="{Binding Cells}" Margin="0,1">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Text}" Width="{Binding Width}"
                                                                                   Style="{StaticResource Style.SubTableCell}"
                                                                                   ToolTip="{Binding Text}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <!-- 波形 -->
                                <Border Margin="8,2,8,10" CornerRadius="6" Padding="0,6,0,0"
                                        Background="{StaticResource Brush.Panel.Background}"
                                        BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                        Visibility="{Binding IsWaveformExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,4">
                                            <materialDesign:PackIcon Kind="ChartLine" Width="14" Height="14"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource Brush.Primary}"/>
                                            <TextBlock Text="波形" FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource Brush.Text.Main}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding WaveformUnit, StringFormat='单位：{0}'}"
                                                       Style="{StaticResource Style.SubText}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,4">
                                            <ToggleButton Content="收起" FontSize="11" Padding="8,2"
                                                          IsChecked="{Binding IsWaveformExpanded, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="仪器输出波形" FontSize="11"
                                                   Foreground="{StaticResource Brush.Text.Sub}" Margin="12,6,0,0"
                                                   Visibility="{Binding HasInlineWaveform, Converter={StaticResource BoolToVisibility}}"/>
                                        <views:PressureWaveformControl Grid.Row="2" Grid.ColumnSpan="2" Height="180"
                                                                       Margin="12,4,12,10"
                                                                       Samples="{Binding WaveformSamples}"
                                                                       Unit="{Binding WaveformUnit}"
                                                                       PixelsPerSecond="{Binding TimeScale}"
                                                                       Visibility="{Binding HasInlineWaveform, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader}"/>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="测试内容" Binding="{Binding Name, Mode=OneWay}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="说明" Binding="{Binding Description, Mode=OneWay}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="规格范围" Binding="{Binding SpecText, Mode=OneWay}" Width="1.2*">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="仪器测试值" Binding="{Binding InstrumentValueText, Mode=OneWay}" Width="*">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="产品上报值" Binding="{Binding ProductValueText, Mode=OneWay}" Width="*">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="结果" Width="0.7*">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResultText, Mode=OneWay}" Style="{StaticResource Style.ResultText}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 波形折叠按钮 -->
                            <DataGridTemplateColumn Header="波形" Width="0.4*">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton ToolTip="展开/收起压力波形"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsWaveformExpanded, Mode=TwoWay}"
                                                      Visibility="{Binding ShowWaveformToggle, Converter={StaticResource BoolToVisibility}}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                    <Setter Property="Padding" Value="4"/>
                                                    <Setter Property="Height" Value="26"/>
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- 单板工位 -->
        <views:BoardChannelView DataContext="{Binding Board}"
                                Visibility="{Binding DataContext.IsBoardPage,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BoolToVisibility}}"/>

        <!-- 烧录工位 -->
        <views:FlashingView DataContext="{Binding Flashing}"
                            Visibility="{Binding DataContext.IsFlashingPage,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </DockPanel>
</Window>
