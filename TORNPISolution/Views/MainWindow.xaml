<Window x:Class="TORNPISolution.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TORNPISolution.ViewModels"
        xmlns:views="clr-namespace:TORNPISolution.Views"
        xmlns:models="clr-namespace:TORNPISolution.Share.Models;assembly=TORNPISolution.Share"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dd="urn:gong-wpf-dragdrop"
        mc:Ignorable="d"
        Icon="/Images/logo.ico"
        FontFamily="Microsoft YaHei UI"
        Title="TOR NPI Solution" Height="720" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 明细表单元格文字：垂直居中 + 左边距 8 -->
        <Style x:Key="Style.CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- 短数值列（规格范围/测试值）：垂直 + 水平居中 -->
        <Style x:Key="Style.CellText.Center" TargetType="TextBlock" BasedOn="{StaticResource Style.CellText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 明细表表头：共享基础样式 -->
        <Style x:Key="Style.GridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F3F7"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Panel.Border}"/>
        </Style>

        <!-- 短数值列表头：水平居中 -->
        <Style x:Key="Style.GridColumnHeader.Center" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource Style.GridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- 结果文字颜色：未测试灰 / 合格绿 / 不合格红 -->
        <Style x:Key="Style.ResultText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 模块级结果徽章 -->
        <Style x:Key="Style.ModuleResultBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#EEF1F5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModuleResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Background" Value="#E6F4EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ModuleResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Background" Value="#FDECEC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.ModuleResultBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModuleResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ModuleResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 右侧明细面板的模块结果 -->
        <Style x:Key="Style.DetailResultBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#EEF1F5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPlanModule.ModuleResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Background" Value="#E6F4EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedPlanModule.ModuleResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Background" Value="#FDECEC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.DetailResultBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPlanModule.ModuleResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedPlanModule.ModuleResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 整体方案结果徽章（PASS / NG / 未测试） -->
        <Style x:Key="Style.PlanResultBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#EEF1F5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlanResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Background" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PlanResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Background" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.PlanResultBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlanResult}" Value="{x:Static models:TestResultStatus.Pass}">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PlanResult}" Value="{x:Static models:TestResultStatus.Fail}">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- 第一行：菜单（MaterialDesign 样式） -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource MaterialDesignMenu}"
              Background="{DynamicResource PrimaryHueMidBrush}">
            <Menu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                    <Setter Property="Padding" Value="0,0,0,0"/>
                </Style>
            </Menu.ItemContainerStyle>

            <!-- 文件菜单 -->
            <MenuItem Header="文件" Style="{StaticResource MaterialDesignMenuItem}" Height="30">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="15" Height="15" Margin="0"/>
                </MenuItem.Icon>
                <MenuItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="-20,0,0,0"/>
                    </DataTemplate>
                </MenuItem.HeaderTemplate>
                <MenuItem Header="保存方案" Click="MenuSavePlan_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                <MenuItem Header="加载方案" Click="MenuLoadPlan_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                <Separator/>
                <MenuItem Header="退出" Click="MenuExit_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
            </MenuItem>

            <!-- 配置菜单 -->
            <MenuItem Header="配置" Style="{StaticResource MaterialDesignMenuItem}" Height="30">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="CogOutline" Width="15" Height="15" Margin="0"/>
                </MenuItem.Icon>
                <MenuItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="-20,0,0,0"/>
                    </DataTemplate>
                </MenuItem.HeaderTemplate>
                <MenuItem Header="仪器链接配置" Click="MenuInstrumentConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                <MenuItem Header="血压模拟仪测试配置" Click="MenuBpaParamConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                <MenuItem Header="AECG100参数配置" Click="MenuAecg100ParamConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
                <!--<MenuItem Header="协议命令配置" Click="MenuProtocolCommandConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>-->
            </MenuItem>

            <!-- 通讯菜单 -->
            <MenuItem Header="通讯协议" Style="{StaticResource MaterialDesignMenuItem}" Height="30">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Protocol" Width="15" Height="15" Margin="0"/>
                </MenuItem.Icon>
                <MenuItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="-20,0,0,0"/>
                    </DataTemplate>
                </MenuItem.HeaderTemplate>
                <MenuItem Header="协议命令配置" Click="MenuProtocolCommandConfig_Click" Style="{StaticResource MaterialDesignMenuItem}"/>
            </MenuItem>
        </Menu>

        <!-- 第二行：内容区 -->
        <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左栏：测试模块库（可收缩） ==================== -->
        <Grid Grid.Column="0">

            <!-- 收起态：窄条，点击展开 -->
            <Border Width="30" Cursor="Hand"
                    MouseLeftButtonUp="LibraryStrip_MouseLeftButtonUp"
                    ToolTip="展开测试模块库">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Style.PanelCard}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="»" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,10"/>
                    <TextBlock Text="模&#10;块&#10;库" FontSize="13" LineHeight="20" TextAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Main}"/>
                </StackPanel>
            </Border>

            <!-- 展开态：完整模块库 -->
            <Border Width="250" Style="{StaticResource Style.PanelCard}"
                    Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="测试模块库" Style="{StaticResource Style.PanelTitle}"/>
                            <TextBlock Text="拖拽或双击模块，加入右侧测试方案"
                                       Style="{StaticResource Style.SubText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="«" FontSize="14" FontWeight="Bold"
                                Width="26" Height="26" Padding="0" VerticalAlignment="Top"
                                Style="{StaticResource Style.ToolButton}" Margin="0"
                                ToolTip="收起模块库"
                                Command="{Binding ToggleLibraryCommand}"/>
                    </Grid>

                    <ListBox x:Name="LibraryList" Grid.Row="1"
                             ItemsSource="{Binding AvailableModules}"
                             BorderThickness="0" Background="Transparent"
                             Margin="8,0,8,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             dd:DragDrop.IsDragSource="True"
                             MouseDoubleClick="LibraryList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="2,3"/>
                                <Setter Property="Cursor" Value="SizeAll"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#F8FAFC"
                                                    BorderBrush="{StaticResource Brush.Panel.Border}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Primary.Light}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⠿" FontSize="14" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Text.Sub}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{StaticResource Brush.Text.Main}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Style.SubText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ItemCountText}"
                                               Style="{StaticResource Style.SubText}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 中栏：测试方案 ==================== -->
        <Border Grid.Column="2" Style="{StaticResource Style.PanelCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PlanTitleText}" Style="{StaticResource Style.PanelTitle}"/>
                        <TextBlock Text="{Binding PlanSummaryText}" Style="{StaticResource Style.SubText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- 整体判定：任一模块 FAIL 即 NG，全部 PASS 才 PASS -->
                    <Border Grid.Column="1" Style="{StaticResource Style.PlanResultBadge}"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding PlanResultText}" Style="{StaticResource Style.PlanResultBadgeText}"/>
                    </Border>
                    <Button Grid.Column="2" Content="清空" Style="{StaticResource Style.ToolButton}"
                            VerticalAlignment="Center" Command="{Binding ClearPlanCommand}"/>
                </Grid>

                <!-- 方案模块列表（可拖拽排序，点击查看明细） -->
                <ListBox x:Name="PlanList" Grid.Row="1"
                         ItemsSource="{Binding PlanModules}"
                         SelectionChanged="PlanList_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         Margin="8,0,8,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         dd:DragDrop.DropHandler="{Binding}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="#F8FAFC"
                                                BorderBrush="{StaticResource Brush.Panel.Border}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Primary.Light}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 序号 -->
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource Brush.Primary}" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Sequence}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="{StaticResource Brush.Text.Main}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Style.SubText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 模块结果徽章 -->
                                <Border Grid.Column="2" Style="{StaticResource Style.ModuleResultBadge}"
                                        VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock Text="{Binding ModuleResultText}"
                                               Style="{StaticResource Style.ModuleResultBadgeText}"/>
                                </Border>

                                <!-- 移除按钮 -->
                                <Button Grid.Column="3" Content="✕" FontSize="11" Width="24" Height="24"
                                        Padding="0" Margin="4,0,0,0" Cursor="Hand"
                                        dd:DragDrop.DragSourceIgnore="True"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource Brush.Text.Sub}"
                                        ToolTip="从方案中移除"
                                        Command="{Binding DataContext.RemoveFromPlanCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空方案提示 -->
                <TextBlock Grid.Row="1" Text="将左侧模块拖到这里&#10;组建你的测试方案"
                           TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Sub}" FontSize="13" LineHeight="22"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlanModules.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 方案操作区 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="14,6,14,12">
                    <!-- 图标用 PackIcon 而非 emoji 字符串：emoji 补面字符在 WPF 字体回落下宽度测量异常，曾导致按钮塌成单字形 -->
                    <Button Style="{StaticResource Style.ToolButton}"
                            Command="{Binding SavePlanCommand}" Margin="0,0,8,0"
                            ToolTip="将当前测试方案保存到磁盘">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="保存方案" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Style.ToolButton}"
                            Command="{Binding LoadPlanCommand}" Margin="0,0,8,0"
                            ToolTip="从磁盘加载已保存的测试方案">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="加载方案" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="复位结果" Style="{StaticResource Style.ToolButton}"
                            Command="{Binding ResetPlanCommand}"/>
                    <Button Style="{StaticResource Style.PrimaryButton}"
                            Command="{Binding RunOrStopCommand}">
                        <!-- 空闲时"运行方案"，运行中变"停止"（点停止取消执行，结束后自动变回） -->
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▶ 运行方案"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="■ 停止"/>
                                            <Setter Property="Foreground" Value="#FFC62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 右栏：模块测试明细 ==================== -->
        <Border Grid.Column="4" Style="{StaticResource Style.PanelCard}">
            <Grid>
                <!-- 未选中模块时的占位提示 -->
                <TextBlock Text="点击中间方案列表中的模块&#10;查看测试内容、规格与测试值"
                           TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Sub}" FontSize="13" LineHeight="22">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedPlanModule}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 明细内容 -->
                <Grid Visibility="{Binding HasSelectedPlanModule, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,12,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedPlanModule.Name}" Style="{StaticResource Style.PanelTitle}"/>
                            <TextBlock Text="{Binding SelectedPlanModule.Description}"
                                       Style="{StaticResource Style.SubText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Style.DetailResultBadge}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPlanModule.ModuleResultText}"
                                       Style="{StaticResource Style.DetailResultBadgeText}"/>
                        </Border>
                    </Grid>

                    <!-- 测试项明细表：测试内容 / 规格 / 测试值 / 结果 -->
                        <DataGrid x:Name="DetailGrid" Grid.Row="1" Margin="10,0,10,12"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              RowDetailsVisibilityMode="Visible"
                              EnableRowVirtualization="False" EnableColumnVirtualization="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Brush.Panel.Border}"
                              Background="Transparent" BorderThickness="0"
                              RowHeight="36" FontSize="12"
                              SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <StackPanel Visibility="{Binding HasRowDetails, Converter={StaticResource BoolToVisibility}}">
                                <!-- 逐点结果子表（BP-003）：测试点1..N 依次展示目标/仪器稳压值/产品上报值/误差/判定，哪个点 PASS 哪个点 FAIL 一目了然 -->
                                <Border Margin="8,2,8,4" CornerRadius="6" Padding="12,6"
                                        Background="{StaticResource Brush.Panel.Background}"
                                        BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                        Visibility="{Binding HasPointResults, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <materialDesign:PackIcon Kind="FormatListChecks" Width="14" Height="14"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource Brush.Primary}"/>
                                            <TextBlock Text="逐点结果（误差 ≤2mmHg 为 PASS）" FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource Brush.Text.Main}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <!-- 汇总：共 X 点 Y PASS / Z FAIL + 最大误差所在点，父行精简后这里一眼拿结论 -->
                                            <TextBlock Text="{Binding PointSummaryText}" FontSize="11"
                                                       Foreground="{StaticResource Brush.Text.Sub}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="2.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="测试点" Style="{StaticResource Style.SubText}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="目标(mmHg)" Style="{StaticResource Style.SubText}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="仪器测试值(mmHg)" Style="{StaticResource Style.SubText}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="产品上报值(mmHg)" Style="{StaticResource Style.SubText}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="误差(mmHg)" Style="{StaticResource Style.SubText}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="判定" Style="{StaticResource Style.SubText}" FontSize="11" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding PointResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.9*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="0.9*"/>
                                                            <ColumnDefinition Width="2.2*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Text.Main}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TargetText}" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Text.Main}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding InstrumentText}" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Text.Main}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ProductText}" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Text.Main}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ErrorText}" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Text.Main}"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding ResultDisplay}" Margin="8,0,0,0" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Pass}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <!-- 波形：逐点共用一张压力曲线 -->
                                <Border Margin="8,2,8,10" CornerRadius="6" Padding="0,6,0,0"
                                        Background="{StaticResource Brush.Panel.Background}"
                                        BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                        Visibility="{Binding IsWaveformExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,4">
                                            <materialDesign:PackIcon Kind="ChartLine" Width="14" Height="14"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource Brush.Primary}"/>
                                            <TextBlock Text="波形" FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource Brush.Text.Main}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding WaveformUnit, StringFormat='单位：{0}'}"
                                                       Style="{StaticResource Style.SubText}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Content="收起" Margin="0,0,10,4" Padding="8,2"
                                                      FontSize="11"
                                                      IsChecked="{Binding IsWaveformExpanded, Mode=TwoWay}"/>
                                        <views:PressureWaveformControl Grid.ColumnSpan="2" Height="200"
                                                                       Margin="12,26,12,10"
                                                                       Samples="{Binding WaveformSamples}"
                                                                       Unit="{Binding WaveformUnit}"
                                                                       PixelsPerSecond="{Binding TimeScale}"/>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader}"/>
                        </DataGrid.ColumnHeaderStyle>
                        <!-- 单元格样式 -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="测试内容" Binding="{Binding Name, Mode=OneWay}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="说明" Binding="{Binding Description, Mode=OneWay}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="规格范围" Binding="{Binding SpecText, Mode=OneWay}" Width="1.2*">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="仪器测试值" Binding="{Binding InstrumentValueText, Mode=OneWay}" Width="*">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="产品上报值" Binding="{Binding ProductValueText, Mode=OneWay}" Width="*">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.CellText.Center}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="结果" Width="0.7*">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResultText, Mode=OneWay}" Style="{StaticResource Style.ResultText}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 波形折叠按钮：仅带波形的测试项（BP-001）显示，点击在该行下方展开压力曲线 -->
                            <DataGridTemplateColumn Header="波形" Width="0.4*">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.GridColumnHeader.Center}"/>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton ToolTip="展开/收起压力波形"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsWaveformExpanded, Mode=TwoWay}"
                                                      Visibility="{Binding HasWaveform, Converter={StaticResource BoolToVisibility}}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                    <Setter Property="Padding" Value="4"/>
                                                    <Setter Property="Height" Value="26"/>
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</Window>
