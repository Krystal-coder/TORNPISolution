<Window x:Class="TORNPISolution.Views.PasswordInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="身份验证" Width="320" Height="180"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="用户名" FontSize="12" Foreground="{StaticResource Brush.Text.Sub}" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtUsername" Text="admin" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="密码" FontSize="12" Foreground="{StaticResource Brush.Text.Sub}" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PwdBox" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource Style.ToolButton}" IsCancel="True" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="确定" Style="{StaticResource Style.PrimaryButton}" MinWidth="88" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
