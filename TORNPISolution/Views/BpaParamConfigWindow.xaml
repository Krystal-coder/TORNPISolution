<Window x:Class="TORNPISolution.Views.BpaParamConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TORNPISolution.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="血压模拟仪测试配置" Width="840" Height="620"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 数值转换器 -->
        <conv:BoolToVisibilityConverter x:Key="KwVis"/>
        <conv:BoolToTextConverter x:Key="BoolToText"/>
        <conv:LenientNumberConverter x:Key="LenientNumber"/>

        <!-- 输入框 / 标签 / 分组标题规格统一用 App.xaml  -->
        <Style TargetType="TextBox" BasedOn="{StaticResource Style.CfgBox}"/>

        <!-- 参数编辑器模板：测试参数 -->
        
        <DataTemplate x:Key="Tpl.ParamsEditor">
        <TabControl Style="{StaticResource Style.NavTabControl}" Background="Transparent" TabStripPlacement="Left"
                    ItemContainerStyle="{StaticResource Style.NavTabItem}">

            <!-- 充放气规格 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockFast" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="充放气规格" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="8,4">

                    <TextBlock Text="超时保护（超时自动停止本轮并判 FAIL，避免一直充气不停止）" Style="{StaticResource Style.GroupTitle}"/>
                    <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                            CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,4,16,4">
                                <TextBlock Text="等待按键启动超时" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.CuffTest.WaitStartTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Text="秒（s）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="整轮测量超时" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.CuffTest.TotalTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Text="秒（s）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                </StackPanel>
            </TabItem>

            <!-- 静态压力 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Gauge" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="静态压力" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- BPA 充气（鲸扬 SDK 概念，康伟达逐点压力源无此选项，隐藏） -->
                        <TextBlock Text="充气方式" Style="{StaticResource Style.GroupTitle}"
                                   Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}"/>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}">
                            <TextBlock Text="{Binding SelfInflationLabel}" Style="{StaticResource Style.CfgLabel}"/>
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding Params.StaticPressure.BpaInflation, Mode=TwoWay}"
                                          Width="50" Height="30" Margin="8,0"/>
                            <TextBlock Text="关闭 = 外部设备充气" Style="{StaticResource Style.Hint}"/>
                        </StackPanel>

                        <!-- 量测时间（仅鲸扬 SDK 生效；康伟达稳压窗按收敛判定 2.5~3.5s，不读此参数，隐藏） -->
                        <TextBlock Text="量测时间" Style="{StaticResource Style.GroupTitle}"
                                   Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}"/>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}">
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="90"
                                     Text="{Binding Params.StaticPressure.MeasureSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="秒（每个压力点的稳压保持时间，0~999）" Style="{StaticResource Style.Hint}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,14,0,8">
                            <TextBlock Text="压力点（勾选的点参与测试，逐点循环执行）" Style="{StaticResource Style.GroupTitle}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="全选" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectAllPoints, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <Button Content="添加压力点" Style="{StaticResource Style.ToolButton}"
                                        Command="{Binding AddPointCommand}"
                                        ToolTip="最多添加 10 个压力点" Margin="0"/>
                            </StackPanel>
                        </Grid>

          
                        <!-- 列表区保持最小高度：删空压力点后仍保留表格框，中间显示占位提示 -->
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" MinHeight="76">
                            <Grid>
                                <TextBlock Text="暂无压力点，点上方“添加压力点”新增（最多 10 个）"
                                           Style="{StaticResource Style.Hint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding PointsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding Points}" Margin="8,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center" Margin="4,0,10,0"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource Style.CfgBox}"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Style.Hint}"
                                                           Text="单位跟随仪器压力单位（mmHg 20~400 / kPa 2.7~53.3）"
                                                           Margin="10,0,0,0"/>
                                                <Button Grid.Column="3" Width="24" Height="24" Padding="0"
                                                        ToolTip="删除该压力点"
                                                        Command="{Binding DataContext.RemovePointCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <TextBlock Text="点间泄压" Style="{StaticResource Style.GroupTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="泄压（每点测完先回零再升下一点）" GroupName="StaticVent" VerticalAlignment="Center"
                                         IsChecked="{Binding StaticVentDuringRest, Mode=TwoWay}" Margin="0,0,12,0"/>
                            <RadioButton Content="不泄（点间不等归零，直接升下一点）" GroupName="StaticVent" VerticalAlignment="Center"
                                         IsChecked="{Binding StaticVentHold, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="说明：&#10;BPA700 SDK 一次调用只支持 1 个压力点（BPARunStaticPressure），由上位机按勾选的点循环调用；&#10;选「泄压」时每点测完等仪器恢复（0~10 秒，随上一点压力升高而变长）并回读确认归零后再升下一点，整轮耗时会增加；&#10;两台仪器点间都保不住压：BPA700 无泄压命令、残压自行回落，康伟达逐点压力源收敛、下一点开头的清场仪式泄残压，选「不泄」只是省掉等待与确认；&#10;最多 10 个压力点；每个压力点一条独立曲线，只绘制本点那一段。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 动态血压 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartPulse" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="动态血压" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- 方法 + 类型；选 Customized 时出现包络曲线图标，点击进 Oscillation Shape 配置（均为鲸扬 SDK 概念，康伟达固定 0x30 自定义臂袖带，隐藏） -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}">
                            <TextBlock Text="方法" Style="{StaticResource Style.CfgLabel}"/>
                            <ComboBox Width="150" ItemsSource="{Binding DynamicMethods}"
                                      SelectedItem="{Binding DynamicMethod, Mode=TwoWay}"/>
                            <Button ToolTip="打开 Oscillation Shape 包络曲线配置"
                                    Click="OpenOscillationShape_Click" Padding="4" Height="30" Margin="6,0,0,0"
                                    Visibility="{Binding IsCustomizedMethod, Converter={StaticResource BoolToVisibility}}">
                                <materialDesign:PackIcon Kind="Pulse" Width="18" Height="18"/>
                            </Button>
                            <TextBlock Text="类型" Style="{StaticResource Style.CfgLabel}" Margin="28,0,8,0"/>
                            <ComboBox Width="150" ItemsSource="{Binding DynamicCategories}"
                                      SelectedItem="{Binding DynamicCategory, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- 血压默认值：仅 Default 方法可选，列表随类型变化，选中即填充下方收缩压/舒张压 -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="血压默认值" Style="{StaticResource Style.CfgLabel}"/>
                            <ComboBox Width="150" ItemsSource="{Binding BpDefaultPresets}"
                                      IsEnabled="{Binding IsDefaultMethod}"
                                      SelectedItem="{Binding SelectedBpPreset, Mode=TwoWay}"/>
                            <TextBlock Text="Default方法可选；选中即填充下方收缩压/舒张压"
                                       Style="{StaticResource Style.Hint}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Default 方法参数（选 Customized 时不可选；收缩/舒张压由血压默认值下拉填充） -->
                        <TextBlock Text="血压默认参数（Default 方法）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12"
                                IsEnabled="{Binding IsDefaultMethod}">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="收缩压" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.Systolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg 25~300 / kPa 3.3~39.9" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="舒张压" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.Diastolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg 10~250 / kPa 1.3~33.3" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4"
                                            Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}">
                                    <TextBlock Text="收缩压偏移" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.EnvelopSystolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg -20~20 / kPa -2.6~2.6" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4"
                                            Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}">
                                    <TextBlock Text="舒张压偏移" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.EnvelopDiastolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg -20~20 / kPa -2.6~2.6" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- 心率与脉搏量：鲸扬仅 Customized 方法可设置；康伟达 0x02 血压模拟帧直接携带心率/脉搏量-->
                        <TextBlock Text="{Binding IsKangwenda, Converter={StaticResource BoolToText}, ConverterParameter='心率与脉搏量（康伟达血压模拟帧直接携带）|心率与脉搏量（仅 Customized 方法可设置）'}"
                                   Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12"
                                IsEnabled="{Binding IsCustomizedMethod, Converter={StaticResource KwVis}}">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="心率" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.HeartRate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="30~300 BPM" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="脉搏量" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.PulseVolume, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="0.1~2.0 ml（心率 &gt;150 时 0.1~1.0 ml）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- Customized 包络参数；鲸扬专属说明，康伟达隐藏 -->
                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}"
                                   Text="说明：选 Customized 方法后，点“方法”右侧的包络曲线图标进入 Oscillation Shape 页配置包络参数；&#10;x 轴八点须满足 SP2 &gt; PS &gt; SYS &gt; MAP2 &gt; MAP1 &gt; DIAS &gt; PD &gt; SP1（mmHg 0~299），y 轴五点百分比 0~100。"/>

                        <!-- 血压测试点位：BP-004 压力组（心率全模块一个值） -->
                        <Grid Margin="0,20,0,8">
                            <TextBlock Text="BP-004 压力组（勾选行参与测试，逐组逐轮血压模拟）" Style="{StaticResource Style.GroupTitle}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="全选" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectAllBpAccuracyGroups, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <Button Content="添加压力组" Style="{StaticResource Style.ToolButton}"
                                        Command="{Binding AddBpAccuracyGroupCommand}"
                                        ToolTip="最多添加 10 组压力" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="心率" Style="{StaticResource Style.CfgLabel}"/>
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="70"
                                     ToolTip="BPM，所有压力组共用，设置到仪器驱动脉搏波"
                                     Text="{Binding BpAccuracyHeartRate, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="BPM（所有压力组共用）" Style="{StaticResource Style.Hint}" Margin="8,0,16,0"/>
                            <TextBlock Text="每组轮数" Style="{StaticResource Style.CfgLabel}"/>
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="70"
                                     Text="{Binding BpAccuracyRepeats, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="轮（少于 3 自动抬到 3）" Style="{StaticResource Style.Hint}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="轮间休息" Style="{StaticResource Style.CfgLabel}"/>
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="70"
                                     Text="{Binding BpAccuracyRestSeconds, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="秒" Style="{StaticResource Style.Hint}" Margin="8,0,16,0"/>
                            <TextBlock Text="休息时" Style="{StaticResource Style.CfgLabel}"/>
                            <RadioButton Content="泄压" GroupName="BpAccuracyVent" VerticalAlignment="Center"
                                         IsChecked="{Binding BpAccuracyVentDuringRest, Mode=TwoWay}" Margin="0,0,12,0"/>
                            <RadioButton Content="不泄" GroupName="BpAccuracyVent" VerticalAlignment="Center"
                                         IsChecked="{Binding BpAccuracyVentHold, Mode=TwoWay}"/>
                        </StackPanel>

                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" MinHeight="76">
                            <Grid>
                                <TextBlock Text="暂无压力组，点上方“添加压力组”新增（最多 10 组）"
                                           Style="{StaticResource Style.Hint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding BpAccuracyGroupsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding BpAccuracyGroups}" Margin="8,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                              VerticalAlignment="Center" Margin="4,0,10,0"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource Style.CfgBox}"
                                                             ToolTip="收缩压（mmHg）"
                                                             Text="{Binding Systolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                                    <TextBox Grid.Column="2" Style="{StaticResource Style.CfgBox}"
                                                             ToolTip="舒张压（mmHg）"
                                                             Text="{Binding Diastolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                                    <TextBlock Grid.Column="3" Style="{StaticResource Style.Hint}"
                                                               Text="依次：收缩压 / 舒张压"
                                                               Margin="10,0,0,0"/>
                                                    <Button Grid.Column="4" Width="24" Height="24" Padding="0"
                                                            ToolTip="删除该压力组"
                                                            Command="{Binding DataContext.RemoveBpAccuracyGroupCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="说明：“血压动态压力精度测试”（BP-004）按这份压力组、轮数与休息参数生成测试项；&#10;每轮一条独立曲线，休息段不绘制；偏差与极差均判 ≤±2mmHg，需连接储气瓶产生脉搏波。"/>

                        <!-- 血压心率点位：BP-005 心率点（血压只用一组，心率可多点） -->
                        <Grid Margin="0,20,0,8">
                            <TextBlock Text="BP-005 心率点（血压只用一组，勾选的心率点逐点轮测）" Style="{StaticResource Style.GroupTitle}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="全选" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectAllBpHeartRatePoints, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <Button Content="添加心率点" Style="{StaticResource Style.ToolButton}"
                                        Command="{Binding AddBpHeartRatePointCommand}"
                                        ToolTip="最多添加 10 个心率点" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="收缩压" Style="{StaticResource Style.CfgLabel}"/>
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="70"
                                     Text="{Binding BpHeartRateSystolic, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="舒张压" Style="{StaticResource Style.CfgLabel}" Margin="16,0,8,0"/>
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="70"
                                     Text="{Binding BpHeartRateDiastolic, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="mmHg（血压只用这一组）" Style="{StaticResource Style.Hint}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="每点轮数" Style="{StaticResource Style.CfgLabel}"/>
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="70"
                                     Text="{Binding BpHeartRateRepeats, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="轮（少于 3 自动抬到 3）" Style="{StaticResource Style.Hint}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="轮间休息" Style="{StaticResource Style.CfgLabel}"/>
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="70"
                                     Text="{Binding BpHeartRateRestSeconds, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="秒" Style="{StaticResource Style.Hint}" Margin="8,0,16,0"/>
                            <TextBlock Text="休息时" Style="{StaticResource Style.CfgLabel}"/>
                            <RadioButton Content="泄压" GroupName="BpHeartRateVent" VerticalAlignment="Center"
                                         IsChecked="{Binding BpHeartRateVentDuringRest, Mode=TwoWay}" Margin="0,0,12,0"/>
                            <RadioButton Content="不泄" GroupName="BpHeartRateVent" VerticalAlignment="Center"
                                         IsChecked="{Binding BpHeartRateVentHold, Mode=TwoWay}"/>
                        </StackPanel>

                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" MinHeight="76">
                            <Grid>
                                <TextBlock Text="暂无心率点，点上方“添加心率点”新增（最多 10 个）"
                                           Style="{StaticResource Style.Hint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding BpHeartRatePointsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding BpHeartRatePoints}" Margin="8,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                              VerticalAlignment="Center" Margin="4,0,10,0"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource Style.CfgBox}"
                                                             ToolTip="心率（BPM）"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Style.Hint}"
                                                               Text="心率（BPM 30~300）"
                                                               Margin="10,0,0,0"/>
                                                    <Button Grid.Column="3" Width="24" Height="24" Padding="0"
                                                            ToolTip="删除该心率点"
                                                            Command="{Binding DataContext.RemoveBpHeartRatePointCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="说明：“血压心率精度及重复性测试”（BP-005）按这份心率点、轮数与休息参数生成测试项；&#10;只勾选 60 就只输出 120/80/60；偏差与极差按 max(5, 设定心率×5%) 判。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 超压测试 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="超压测试" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="8,4">

                    <!-- BPA 充气（鲸扬 SDK 概念，康伟达压测帧无充气方式选项，隐藏） -->
                    <TextBlock Text="充气方式" Style="{StaticResource Style.GroupTitle}"
                               Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding SelfInflationLabel}" Style="{StaticResource Style.CfgLabel}"/>
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding Params.Overpressure.BpaInflation, Mode=TwoWay}"
                                      Width="50" Height="30" Margin="8,0"/>
                        <TextBlock Text="关闭 = 外部设备充气" Style="{StaticResource Style.Hint}"/>
                    </StackPanel>

                    <TextBlock Text="超压参数（保留仪器过压测试）" Style="{StaticResource Style.GroupTitle}"/>
                    <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                            CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,4,16,4">
                                <TextBlock Text="目标压力" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.Overpressure.TargetPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Text="mmHg 20~400 / kPa 2.7~53.3（单位跟随仪器设置）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="阈值 1" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.Overpressure.Threshold1, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,16,4">
                                <TextBlock Text="阈值 2" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.Overpressure.Threshold2, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 压力控制（BP-006~009 过程参数） -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Speedometer" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="压力控制" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- 激励档：BP-006/007/008 三项共用（模拟仪扮演的“手臂”，独立于 BP-004 压力组） -->
                        <TextBlock Text="激励档（BP-006/007/008 共用：模拟仪只提供脉搏波，充气由产品气泵完成）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="收缩压" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.InflateSystolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="舒张压" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.InflateDiastolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="心率" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.InflateHeartRate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="BPM" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="脉搏量" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.InflatePulseVolume, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="（仪器量程单位）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="BP-007 匀速放气控制（与 BP-006 同一轮采集，取峰值后的匀速段算速率）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="速率计算区间上限" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007RateSegmentHigh, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（区间内样本不足时自动退化为峰值−5 至峰值 20%）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="速率计算区间下限" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007RateSegmentLow, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="分段跨度" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007RateSliceMmHg, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg/段（行详情分段速率只展示不判定；填 0 = 不切段）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="采样结束压力" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007DeflateEndPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（回读降到此值即认为放气采完，提前收尾）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="放气最长等待" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007MaxDeflateSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒（血压模拟曲线结束后最多再等这么久）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="BP-008 快速放气功能（充气中途发 0x79 status=1 触发快排）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="停止触发压力" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP008StopTriggerPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（文档值 260；回读达到即发停止）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="峰值回落逃逸幅度" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP008PeakFallEscapeMmHg, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（产品自己转放气时的兜底触发条件）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="充气等待超时" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP008InflateWaitSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒（窗内既未达触发压力也未自行放气则本项不报告）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="计时终点压力" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP008EndPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（文档值 15，从回读峰值计到首次降至此值）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="归零最长等待" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP008ZeroTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒（窗内未降至终点则测试值给到超时点）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="BP-009 过压保护（0x75 强制充气激励 + 只认 0x80 置位）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="0x75 充气目标" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP009InflateTargetPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（默认 260 低于下方门限，本项现在必然 FAIL；上机确认 0x75 能动作后建议调到 350）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="0x75 最长充气时间" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP009InflateTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒（超时后产品底层自行放气，故不能用压力骤降当保护动作的证据）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="响应时限起点" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP009ResponseStartPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（文档值 300：首次超此压→0x80 置位的间隔 ≤15s）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="超压工况压力" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP009SustainedPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（文档值 330：峰值未到过此值时泄压时长仅供参考）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：BP-006~009 四项均以产品串口回读压力（0x76）判定产品自己的充放气/保护行为，未接产品直接判 FAIL；&#10;充气主体是产品气泵（BP-006/007/008 走 0x79 测量、BP-009 走 0x75 强制充气），模拟仪只当手臂提供脉搏波、不碰它的气源和阀；&#10;规格上下限（≤300mmHg、2~6mmHg/s、≤10s、≤15s、≤3s）由测试要求文档固定，不在此配置；本页只配激励档与计时/定区间参数。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- JJG692-2010 标准检测（仅康伟达 0x04 功能，BPA700 页签隐藏本页） -->
            <TabItem Visibility="{Binding IsKangwenda, Converter={StaticResource KwVis}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckAll" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="JJG692检测" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- 通用：0x12/0x13 帧内袖带类型 + 等待设备回包超时 -->
                        <TextBlock Text="通用参数（仅放气速率/气密性两项帧内使用，设备专属）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="袖带类型" Style="{StaticResource Style.FieldLabel}"/>
                                    <ComboBox Height="30" ItemsSource="{Binding JjgCuffTypes}"
                                              SelectedItem="{Binding JjgCuffType, Mode=TwoWay}"/>
                                    <TextBlock Text="0x12/0x13 帧低 4 位（两项共用）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="检测超时" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgTimeoutSeconds, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒（仅 0x12/0x13 等设备自行升压/循环/泄放的兜底上限）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="血压重复性（已归入 A06 的 BP-004）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <TextBlock Style="{StaticResource Style.Hint}" TextWrapping="Wrap"
                                       Text="协议 0x11 设备自检帧只回“完成/失败”状态位、不带收缩/舒张数值，算不出极差，所以不单设重复性检测模块；&#10;测试要求文档的 BP-004 本就是“动态血压精度及重复性”，已归 A06：一轮一项算偏差、每压力组一项算极差；&#10;压力组与轮数在“动态血压”页配置，±2mmHg 判据按文档写死、不需配置。"/>
                        </Border>

                        <TextBlock Text="放气速率（听诊）（上行 0x04 0x12）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="设定压力点" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgDeflationSetPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="开始气压" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgDeflationStartPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="停止气压" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgDeflationStopPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="合格下限" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgDeflationMinRateText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="mmHg/s" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="合格上限" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgDeflationMaxRateText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="mmHg/s" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="气密性（上行 0x04 0x13）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="设定压力点" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgAirtightSetPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="稳压时间" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgAirtightStabilizeSeconds, UpdateSourceTrigger=LostFocus, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="漏气率上限" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding JjgAirtightMaxLeakRateText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="mmHg/s" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：放气速率（听诊）与气密性为康伟达 0x04 标准检测功能专属（BPA700 无此能力），参数写入 TestParams.Jjg692 节点；&#10;血压重复性已归入 A06 的 BP-004（压力组与轮数在“动态血压”页，±2mmHg 按文档写死）；&#10;判定区间（放气速率下限/上限、漏气率上限）留空时该项不判 PASS/FAIL，仅以文本报实测值。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 波形显示配置 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartLine" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="波形显示配置" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="8,4">

                    <TextBlock Text="按测试项自定义波形显示（Y 轴固定 mmHg）" Style="{StaticResource Style.GroupTitle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="测试项" Style="{StaticResource Style.CfgLabel}"/>
                        <ComboBox Width="240" ItemsSource="{Binding WaveformItemNames}"
                                  SelectedItem="{Binding SelectedWaveformItem, Mode=TwoWay}"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                            CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,4,16,4">
                                <TextBlock Text="Y 轴单位" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}" Text="mmHg" IsReadOnly="True"
                                         Background="{StaticResource Brush.Panel.Background}"/>
                                <TextBlock Text="血压波形纵轴固定为压力单位 mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="X 轴模式" Style="{StaticResource Style.FieldLabel}"/>
                                <ComboBox Height="30" ItemsSource="{Binding XAxisModes}"
                                          SelectedItem="{Binding SelectedXAxisMode, Mode=TwoWay}"/>
                                <TextBlock Text="Time = 时间（秒），SampleIndex = 采样点序号" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,4,16,4" IsEnabled="{Binding IsTimeXAxis}">
                                <TextBlock Text="时间刻度" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding SelectedTimeScale, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Text="像素/秒（默认 24，值越大波形越密）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="说明：修改后保存即写入 instruments.json 当前设备页签的 TestParams.WaveformDisplay 节点，&#10;下次运行测试时波形控件按此处配置渲染；未配置的项使用默认值（Time 模式、24 px/s）。"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- 生效来源提示 -->
        <Border DockPanel.Dock="Top" Margin="12,10,12,0" Padding="10,6" CornerRadius="4"
                Background="#FFF7E6" BorderBrush="#F0C36D" BorderThickness="1"
                Visibility="{Binding IsViewingActiveDevice, Converter={StaticResource KwVis}, ConverterParameter=invert}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Foreground="#8A6100"/>
                <TextBlock Text="{Binding InactiveDeviceHint}" FontSize="12" TextWrapping="Wrap"
                           MaxWidth="560" VerticalAlignment="Center" Foreground="#6B4C00"/>
                <Button Content="复制生效设备的点位过来" Style="{StaticResource Style.ToolButton}"
                        Margin="12,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}"
                        Command="{Binding CopyPointsFromActiveCommand}"
                        ToolTip="只复制静态压力点、血压点位与重复轮数；充气方式/量测时间/方法/包络/JJG692 这些设备专属参数不动"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮栏 -->
        <Grid DockPanel.Dock="Bottom" Margin="16,10,16,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="测试运行中：参数配置已锁定，停止测试后才能修改保存"
                           Foreground="{StaticResource Brush.Fail}" FontWeight="Bold"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="保存后写入 Config\instruments.json"
                           Style="{StaticResource Style.Hint}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Style.ToolButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="保存" Style="{StaticResource Style.PrimaryButton}"
                        MinWidth="88" IsEnabled="{Binding CanSave}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 外层设备页签：BPA700 / 康伟达 -->
        <TabControl Margin="12,10,12,0" Background="Transparent"
                    IsEnabled="{Binding CanEdit}"
                    SelectedIndex="{Binding SelectedDeviceIndex, Mode=TwoWay}"
                    materialDesign:TabAssist.UseNavigationPanel="True">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Gauge" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Bpa700TabHeader}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Tpl.ParamsEditor}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartPulse" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding KangwendaTabHeader}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Tpl.ParamsEditor}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>