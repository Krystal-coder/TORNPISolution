<Window x:Class="TORNPISolution.Views.BpaParamConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TORNPISolution.ViewModels"
        xmlns:conv="clr-namespace:TORNPISolution.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="血压模拟仪测试配置" Width="760" Height="680"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI">

    <Window.DataContext>
        <vm:BpaParamConfigViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 数值转换器 -->
        <conv:LenientNumberConverter x:Key="LenientNumber"/>

        <!-- 字段标签 -->
        <Style x:Key="Style.CfgLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 数值输入框 -->
        <Style x:Key="Style.CfgBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="Style.GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <!-- 单位/范围提示小字 -->
        <Style x:Key="Style.Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 动态血压参数字段：标签 + 输入框 -->
        <Style x:Key="Style.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ====== 参数编辑器模板：六类测试参数 TabControl（充放气规格 / 静态压力 / 动态血压 / 超压测试 / 压力控制 / 波形显示），
             两台设备页签共用，DataContext 继承窗口 VM，绑定 Params.* 按 SelectedDeviceIndex 自动路由 ====== -->
        <DataTemplate x:Key="Tpl.ParamsEditor">
        <TabControl Background="Transparent"
                    materialDesign:TabAssist.UseNavigationPanel="True">

            <!-- ============ 充放气规格（产品充放气测试 BP-001/BP-002） ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockFast" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="充放气规格" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="8,4">

                    <!-- 超时保护：避免产品异常时一直充气不停止 -->
                    <TextBlock Text="超时保护（超时自动停止本轮并判 FAIL，避免一直充气不停止）" Style="{StaticResource Style.GroupTitle}"/>
                    <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                            CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,4,16,4">
                                <TextBlock Text="等待按键启动超时" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.CuffTest.WaitStartTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Text="秒（BPARunBPTest 进入待测后，等待产品物理[开始]键的最长时间）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="整轮测量超时" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.CuffTest.TotalTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Text="秒（启动后充气→稳压→放气全程的兜底上限）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- 放气规格：BP-002 快速放气时间上限 -->
                    <TextBlock Text="放气规格（BP-002 测量中手动停止）" Style="{StaticResource Style.GroupTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Style.CfgBox}" Width="90"
                                 Text="{Binding Params.CuffTest.MaxDeflationSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                        <TextBlock Text="秒（快速放气时间 ≤ 上限视为放气完成 = PASS，如 20 即规格 0~20s）" Style="{StaticResource Style.Hint}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="说明：BP-001 按所用模拟仪判定（BPA700=status 序列 Busy→Stable→Finish；康伟达=AA 压力曲线），拿到产品连调后改按产品状态判定；&#10;BPA700 充放气时间由 SDK 回调直接返回，康伟达由压力曲线计时。"/>
                </StackPanel>
            </TabItem>

            <!-- ============ 静态压力 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Gauge" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="静态压力" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- BPA 充气 -->
                        <TextBlock Text="充气方式" Style="{StaticResource Style.GroupTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelfInflationLabel}" Style="{StaticResource Style.CfgLabel}"/>
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding Params.StaticPressure.BpaInflation, Mode=TwoWay}"
                                          Width="50" Height="30" Margin="8,0"/>
                            <TextBlock Text="关闭 = 外部设备充气" Style="{StaticResource Style.Hint}"/>
                        </StackPanel>

                        <!-- 量测时间 -->
                        <TextBlock Text="量测时间" Style="{StaticResource Style.GroupTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource Style.CfgBox}" Width="90"
                                     Text="{Binding Params.StaticPressure.MeasureSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            <TextBlock Text="秒（每个压力点的稳压保持时间，0~999）" Style="{StaticResource Style.Hint}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- 压力点列表 -->
                        <Grid Margin="0,14,0,8">
                            <TextBlock Text="压力点（勾选的点参与测试，逐点循环执行）" Style="{StaticResource Style.GroupTitle}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="全选" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectAllPoints, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <Button Content="添加压力点" Style="{StaticResource Style.ToolButton}"
                                        Command="{Binding AddPointCommand}"
                                        ToolTip="最多添加 10 个压力点（与官方上位机一致）" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 列表区保持最小高度：删空压力点后仍保留表格框，中间显示占位提示 -->
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" MinHeight="76">
                            <Grid>
                                <TextBlock Text="暂无压力点，点上方“添加压力点”新增（最多 10 个）"
                                           Style="{StaticResource Style.Hint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding PointsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                <ItemsControl ItemsSource="{Binding Points}" Margin="8,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center" Margin="4,0,10,0"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource Style.CfgBox}"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Style.Hint}"
                                                           Text="单位跟随仪器压力单位（mmHg 20~400 / kPa 2.7~53.3）"
                                                           Margin="10,0,0,0"/>
                                                <Button Grid.Column="3" Width="24" Height="24" Padding="0"
                                                        ToolTip="删除该压力点"
                                                        Command="{Binding DataContext.RemovePointCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="说明：BPA700 SDK 一次调用只支持 1 个压力点（BPARunStaticPressure），由上位机按勾选的点循环调用；康伟达逐点压力源收敛，点间自动放气回零；最多 10 个压力点。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 动态血压 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartPulse" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="动态血压" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- 方法 + 类型；选 Customized 时出现包络曲线图标，点击进 Oscillation Shape 配置 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="方法" Style="{StaticResource Style.CfgLabel}"/>
                            <ComboBox Width="150" ItemsSource="{Binding DynamicMethods}"
                                      SelectedItem="{Binding DynamicMethod, Mode=TwoWay}"/>
                            <Button ToolTip="打开 Oscillation Shape 包络曲线配置"
                                    Click="OpenOscillationShape_Click" Padding="4" Height="30" Margin="6,0,0,0"
                                    Visibility="{Binding IsCustomizedMethod, Converter={StaticResource BoolToVisibility}}">
                                <materialDesign:PackIcon Kind="Pulse" Width="18" Height="18"/>
                            </Button>
                            <TextBlock Text="类型" Style="{StaticResource Style.CfgLabel}" Margin="28,0,8,0"/>
                            <ComboBox Width="150" ItemsSource="{Binding DynamicCategories}"
                                      SelectedItem="{Binding DynamicCategory, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- 血压默认值：仅 Default 方法可选，列表随类型变化（括号内为平均动脉压），选中即填充下方收缩压/舒张压 -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="血压默认值" Style="{StaticResource Style.CfgLabel}"/>
                            <ComboBox Width="150" ItemsSource="{Binding BpDefaultPresets}"
                                      IsEnabled="{Binding IsDefaultMethod}"
                                      SelectedItem="{Binding SelectedBpPreset, Mode=TwoWay}"/>
                            <TextBlock Text="Default方法可选；选中即填充下方收缩压/舒张压（括号内为平均动脉压）"
                                       Style="{StaticResource Style.Hint}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Default 方法参数（选 Customized 时不可选，与官方上位机一致；收缩/舒张压由血压默认值下拉填充） -->
                        <TextBlock Text="血压默认参数（Default 方法）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12"
                                IsEnabled="{Binding IsDefaultMethod}">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="收缩压" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.Systolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg 25~300 / kPa 3.3~39.9" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="舒张压" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.Diastolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg 10~250 / kPa 1.3~33.3" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="收缩压偏移" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.EnvelopSystolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg -20~20 / kPa -2.6~2.6" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="舒张压偏移" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.EnvelopDiastolic, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg -20~20 / kPa -2.6~2.6" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- 心率与脉搏量：与官方上位机一致，仅 Customized 方法可设置（不受类型影响） -->
                        <TextBlock Text="心率与脉搏量（仅 Customized 方法可设置）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12"
                                IsEnabled="{Binding IsCustomizedMethod}">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="心率" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.HeartRate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="30~300 BPM" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="脉搏量" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.DynamicBloodPressure.PulseVolume, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="0.1~2.0 ml（心率 &gt;150 时 0.1~1.0 ml）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- Customized 包络参数：点方法旁的图标进 Oscillation Shape 页配置（含曲线预览与滑块调参） -->
                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：选 Customized 方法后，点“方法”右侧的包络曲线图标进入 Oscillation Shape 页配置包络参数；&#10;x 轴八点须满足 SP2 &gt; PS &gt; SYS &gt; MAP2 &gt; MAP1 &gt; DIAS &gt; PD &gt; SP1（mmHg 0~299），y 轴五点百分比 0~100。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 超压测试 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="超压测试" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="8,4">

                    <!-- BPA 充气 -->
                    <TextBlock Text="充气方式" Style="{StaticResource Style.GroupTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelfInflationLabel}" Style="{StaticResource Style.CfgLabel}"/>
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding Params.Overpressure.BpaInflation, Mode=TwoWay}"
                                      Width="50" Height="30" Margin="8,0"/>
                        <TextBlock Text="关闭 = 外部设备充气" Style="{StaticResource Style.Hint}"/>
                    </StackPanel>

                    <!-- 目标压力 / 阈值 -->
                    <TextBlock Text="超压参数（BP-009 过压保护测试）" Style="{StaticResource Style.GroupTitle}"/>
                    <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                            CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,4,16,4">
                                <TextBlock Text="目标压力" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.Overpressure.TargetPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Text="mmHg 20~400 / kPa 2.7~53.3（单位跟随仪器设置）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="阈值 1" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.Overpressure.Threshold1, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,16,4">
                                <TextBlock Text="阈值 2" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding Params.Overpressure.Threshold2, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ============ 压力控制（BP-006~008 过程参数） ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Speedometer" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="压力控制" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4">

                        <!-- BP-006 -->
                        <TextBlock Text="BP-006 匀速放气控制（产品测量周期匀速放气段速率）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="速率计算区间上限" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP006RateSegmentHigh, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（只取峰值后区间内产品回读点计算平均速率，避开起点波动）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="速率计算区间下限" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP006RateSegmentLow, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（避开接近 0 的噪声）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="采样结束压力" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP006DeflateEndPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（产品回读降到该值以下不再纳入速率样本）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="放气最长等待" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP006MaxDeflateSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒（超过即停止采样，兜底）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- BP-007 -->
                        <TextBlock Text="BP-007 快速放气控制（发停止后产品回读归零耗时）" Style="{StaticResource Style.GroupTitle}"/>
                        <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="停止触发压力" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007StopTriggerPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（产品充气回读达到该压力后发停止 0x7D 触发快速放气）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="充气等待超时" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007InflateWaitSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒（超时未达到停止触发压力判 FAIL）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,16,4">
                                    <TextBlock Text="归零判定压力" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007ZeroPressure, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="mmHg（产品回读降到该值以下视为已归零）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="归零最长等待" Style="{StaticResource Style.FieldLabel}"/>
                                    <TextBox Style="{StaticResource Style.CfgBox}"
                                             Text="{Binding Params.PressureControl.BP007ZeroTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                    <TextBlock Text="秒（超时按当前耗时上报，规格 ≤10s 判定不变）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="说明：BP-006~008 三项均以产品串口回读压力判定产品行为（匀速放气速率/快速放气归零耗时/过压保护骤降点），未接产品直接判 FAIL；&#10;规格上下限（2~6mmHg/s、≤10s、300~320mmHg）由测试要求文档固定，不在此配置；BP-008 过压保护的充气目标与阈值在“超压测试”页。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 波形显示配置 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartLine" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="波形显示配置" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="8,4">

                    <TextBlock Text="按测试项自定义波形显示（Y 轴固定 mmHg）" Style="{StaticResource Style.GroupTitle}"/>

                    <!-- 测试项选择 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="测试项" Style="{StaticResource Style.CfgLabel}"/>
                        <ComboBox Width="240" ItemsSource="{Binding WaveformItemNames}"
                                  SelectedItem="{Binding SelectedWaveformItem, Mode=TwoWay}"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="1"
                            CornerRadius="4" Background="{StaticResource Brush.Panel.Background}" Padding="12">
                        <UniformGrid Columns="2">
                            <!-- Y 轴单位（固定） -->
                            <StackPanel Margin="0,4,16,4">
                                <TextBlock Text="Y 轴单位" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}" Text="mmHg" IsReadOnly="True"
                                         Background="{StaticResource Brush.Panel.Background}"/>
                                <TextBlock Text="血压波形纵轴固定为压力单位 mmHg" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- X 轴模式 -->
                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="X 轴模式" Style="{StaticResource Style.FieldLabel}"/>
                                <ComboBox Height="30" ItemsSource="{Binding XAxisModes}"
                                          SelectedItem="{Binding SelectedXAxisMode, Mode=TwoWay}"/>
                                <TextBlock Text="Time = 时间（秒），SampleIndex = 采样点序号" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- 时间刻度（仅 Time 模式可用） -->
                            <StackPanel Margin="0,4,16,4" IsEnabled="{Binding IsTimeXAxis}">
                                <TextBlock Text="时间刻度" Style="{StaticResource Style.FieldLabel}"/>
                                <TextBox Style="{StaticResource Style.CfgBox}"
                                         Text="{Binding SelectedTimeScale, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource LenientNumber}}"/>
                                <TextBlock Text="像素/秒（默认 24，值越大波形越密）" Style="{StaticResource Style.Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <TextBlock Style="{StaticResource Style.Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="说明：修改后保存即写入 instruments.json 当前设备页签的 TestParams.WaveformDisplay 节点，&#10;下次运行测试时波形控件按此处配置渲染；未配置的项使用默认值（Time 模式、24 px/s）。"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- ====== 底部按钮栏 ====== -->
        <Grid DockPanel.Dock="Bottom" Margin="16,10,16,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="测试运行中：参数配置已锁定，停止测试后才能修改保存"
                           Foreground="{StaticResource Brush.Fail}" FontWeight="Bold"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="保存后写入 Config\instruments.json 当前设备页签的 TestParams 节点，测试模块按仪器链接配置选择的模拟仪读取"
                           Style="{StaticResource Style.Hint}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Style.ToolButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="保存" Style="{StaticResource Style.PrimaryButton}"
                        MinWidth="88" IsEnabled="{Binding CanSave}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ====== 外层设备页签：BPA700 / 康伟达 各自一套同构测试参数（共用同一参数编辑器模板） ====== -->
        <TabControl Margin="12,10,12,0" Background="Transparent"
                    IsEnabled="{Binding CanEdit}"
                    SelectedIndex="{Binding SelectedDeviceIndex, Mode=TwoWay}"
                    materialDesign:TabAssist.UseNavigationPanel="True">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Gauge" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="BPA700（鲸杨）" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Tpl.ParamsEditor}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartPulse" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="康伟达" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Tpl.ParamsEditor}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>