<Window x:Class="TORNPISolution.Views.BoardTestItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TORNPISolution.ViewModels"
        mc:Ignorable="d"
        Title="测试项" Width="620" Height="600" MinWidth="520" MinHeight="380"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI"
        d:DataContext="{d:DesignInstance Type=viewModels:BoardChannelViewModel}">

    <!-- 本轮跑哪几项，单独一扇窗：菜单「测试项」直接开这里，不再挤在「单板配置」里当第三页。
         项数会长到几十，所以是弹窗而不是菜单下拉；它吃的是单板页那份活配置，不另建一份清单。 -->
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="测试项" Style="{StaticResource Style.PanelTitle}"/>
            <TextBlock Style="{StaticResource Style.SubText}" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0"
                       Text="勾出本轮要跑哪几项，八条通道共用这一组；通道本身的位号与跑不跑在菜单「配置 → 单板配置」里改。"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SelectedItemsText}" Style="{StaticResource Style.SubText}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="全选" Style="{StaticResource Style.ToolButton}" Click="SelectAll_Click"/>
                <Button Content="全不选" Style="{StaticResource Style.ToolButton}" Margin="8,0,0,0"
                        Click="SelectNone_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Style.PanelCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Panel.Border}" BorderThickness="0,0,0,1"
                                    Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="{Binding Name}" FontSize="13"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Selected, Mode=TwoWay}"/>
                                    <!-- 项名背后再念一句属于哪个模块：项数一多，没有这句就看不出哪几项是同一次采集带出来的 -->
                                    <TextBlock Grid.Column="1" Text="{Binding ModuleText}" FontSize="11"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{StaticResource Brush.Text.Sub}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="3" Margin="2,12,2,0" LastChildFill="False">
            <!-- MaxWidth 留足两颗按钮的位子：DockPanel 里先 dock 的先占位，写宽了窗口拉到最窄时「保存」会被顶出去 -->
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Style="{StaticResource Style.SubText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" LineHeight="18"/>

            <Button DockPanel.Dock="Right" Content="取消" Style="{StaticResource Style.ToolButton}"
                    Margin="10,0,0,0" Click="Cancel_Click" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="保存" Style="{StaticResource Style.PrimaryButton}"
                    Click="Save_Click" IsDefault="True"
                    ToolTip="勾法其实每改一项就已经写进 board-test.json；按保存表示这一组认了，关窗不再退回"/>
        </DockPanel>
    </Grid>
</Window>
