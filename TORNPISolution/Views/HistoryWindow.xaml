<Window x:Class="TORNPISolution.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:TORNPISolution.Views"
        Title="历史数据" Width="1280" Height="720" MinWidth="1080" MinHeight="640"
        Icon="/Images/logo.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:RatioToBarColumnConverter x:Key="RatioToBarColumn"/>

        <!-- 轮次/模块判定徽章（PASS / FAIL / 未完成，与主界面同色系） -->
        <Style x:Key="Style.HistoryVerdictBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Background" Value="#EEF1F5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictText}" Value="PASS">
                    <Setter Property="Background" Value="{StaticResource Brush.Pass.Light}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictText}" Value="FAIL">
                    <Setter Property="Background" Value="{StaticResource Brush.Fail.Light}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.HistoryVerdictBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictText}" Value="PASS">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictText}" Value="FAIL">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 模块级徽章：绑 ModuleDetail.Verdict，与顶部徽章同口径，因绑定路径不同另建一对 -->
        <Style x:Key="Style.HistoryModuleBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Background" Value="#EEF1F5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="PASS">
                    <Setter Property="Background" Value="{StaticResource Brush.Pass.Light}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="FAIL">
                    <Setter Property="Background" Value="{StaticResource Brush.Fail.Light}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.HistoryModuleBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="PASS">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="FAIL">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 测试项判定文本（PASS / FAIL / 未测 / 统计，统计=只展示项不着色强调） -->
        <Style x:Key="Style.HistoryItemResult" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.NotTested}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultText}" Value="PASS">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="统计">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- 底部：状态行 + 导出/刷新/关闭 -->
        <Grid DockPanel.Dock="Bottom" Margin="16,8,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       Style="{StaticResource Style.SubText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding ExportCommand}" Style="{StaticResource Style.PrimaryButton}"
                        MinWidth="96" Margin="0,0,8,0"
                        ToolTip="把选中轮次重新导出一份 PDF（数据已入库，这里只补文档）">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="14" Height="14"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="导出报告" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource Style.ToolButton}"
                        Margin="0,0,8,0" ToolTip="重新从数据库加载轮次列表">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="关闭" Style="{StaticResource Style.ToolButton}"
                        MinWidth="72" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- 主体：左轮次列表 + 右明细 -->
        <Grid Margin="16,12,16,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：轮次列表 -->
            <Border Grid.Column="0" Style="{StaticResource Style.PanelCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                                 Foreground="{StaticResource Brush.Primary}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="测试轮次" Style="{StaticResource Style.PanelTitle}"/>
                            <TextBlock Text="按完成时间倒序，点击一轮查看明细"
                                       Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="RunList"
                                 ItemsSource="{Binding Runs}"
                                 SelectedItem="{Binding SelectedRun}"
                                 BorderThickness="0" Background="Transparent"
                                 Margin="10,0,10,10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="#F8FAFC"
                                                        BorderBrush="{StaticResource Brush.Panel.Border}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Primary.Light}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 编号 + 判定徽章 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ReportNo}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text.Main}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource Style.HistoryVerdictBadge}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VerdictText}"
                                                           Style="{StaticResource Style.HistoryVerdictBadgeText}"/>
                                            </Border>
                                        </Grid>

                                        <!-- 方案名 -->
                                        <TextBlock Grid.Row="1" Text="{Binding PlanName}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource Brush.Text.Main}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- 模块一览 -->
                                        <TextBlock Grid.Row="2" Text="{Binding ModulesText}"
                                                   Style="{StaticResource Style.SubText}"
                                                   FontSize="10" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- 完成时间 -->
                                        <TextBlock Grid.Row="3" Text="{Binding TimeText}"
                                                   Style="{StaticResource Style.SubText}"
                                                   FontSize="10" Margin="0,2,0,0"/>

                                        <!-- MAC（无 MAC 的轮次整行隐藏） -->
                                        <TextBlock Grid.Row="4" Text="{Binding MacText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Style.SubText}">
                                                    <Setter Property="FontSize" Value="10"/>
                                                    <Setter Property="Margin" Value="0,2,0,0"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MacText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 计数摘要 -->
                                        <TextBlock Grid.Row="5" Text="{Binding CountsText}"
                                                   Style="{StaticResource Style.SubText}"
                                                   FontSize="10" Margin="0,2,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 加载态：查询在后台线程跑，这几秒列表是空的 -->
                        <TextBlock Text="正在加载…" FontSize="12"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Sub}"/>

                        <!-- 列表空态：条件里排除"还在加载"，避免加载期间显示"没数据" -->
                        <TextBlock Text="数据库里还没有测试记录&#10;整机方案完整跑完会自动入库"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Style.SubText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasItems, ElementName=RunList}" Value="False"/>
                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右：轮次明细 / 区间统计 两个页签 -->
            <TabControl Grid.Column="1" Margin="4,0,0,0" Background="Transparent" BorderThickness="0">
                <TabItem Header="轮次明细">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4,0,0">
                <StackPanel>

                    <!-- 明细空态 -->
                    <TextBlock Text="从左侧选一轮测试，这里显示它的模块明细"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,40,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.SubText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 明细头 + 模块分节 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- 轮次头信息：DataContext 绑到 Detail，内部用裸属性路径，徽章触发器才认得出 VerdictText -->
                        <Border Style="{StaticResource Style.PanelCard}" Padding="0" Margin="0,0,0,10"
                                DataContext="{Binding Detail}">
                            <StackPanel>
                                <Grid Margin="14,12,14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ReportNo}"
                                                   Style="{StaticResource Style.PanelTitle}"/>
                                        <TextBlock Text="{Binding PlanName}"
                                                   Style="{StaticResource Style.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Style.HistoryVerdictBadge}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VerdictText}"
                                                   Style="{StaticResource Style.HistoryVerdictBadgeText}"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="14,0,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLbl"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLbl"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Sub}"/>
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="工位"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Station}"
                                               Foreground="{StaticResource Brush.Text.Main}" Margin="0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="起止时间"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding TimeText}"
                                               Foreground="{StaticResource Brush.Text.Main}" Margin="0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="产品 MAC"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProductMAC, TargetNullValue=—}"
                                               Foreground="{StaticResource Brush.Text.Main}" Margin="0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="测试统计"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding CountsText}"
                                               Foreground="{StaticResource Brush.Text.Main}" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 模块章节：一个模块一节，章节数随方案变 -->
                        <ItemsControl ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Style.PanelCard}" Padding="0" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- 模块头：编号 + 名称 + 徽章 -->
                                            <Grid Margin="14,10,14,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ModuleId}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Primary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ModuleName}"
                                                           FontSize="12" Margin="8,0,0,0"
                                                           Foreground="{StaticResource Brush.Text.Main}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" Style="{StaticResource Style.HistoryModuleBadge}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Verdict}"
                                                               Style="{StaticResource Style.HistoryModuleBadgeText}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding CountsText}"
                                                       Style="{StaticResource Style.SubText}"
                                                       FontSize="10" Margin="14,0,14,8"/>

                                            <!-- 测试项 -->
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="14,0,14,10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding ItemName}"
                                                                               FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource Brush.Text.Main}"/>
                                                                    <TextBlock Text="{Binding SpecText}"
                                                                               Style="{StaticResource Style.SubText}"
                                                                               FontSize="10" Margin="0,2,0,0"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                                                           FontSize="12" Margin="12,0"
                                                                           Foreground="{StaticResource Brush.Text.Main}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                                                           Style="{StaticResource Style.SubText}"
                                                                           FontSize="10" MinWidth="34" TextAlignment="Right"
                                                                           Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding ResultText}"
                                                                           Style="{StaticResource Style.HistoryItemResult}"
                                                                           MinWidth="32" TextAlignment="Right"/>
                                                            </Grid>

                                                            <!-- 子表行（Channel/Repeat/Event/Slice 口径的项才有，缩进展示） -->
                                                            <ItemsControl ItemsSource="{Binding SubRows}" Margin="12,4,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}"
                                                                                   Style="{StaticResource Style.SubText}"
                                                                                   FontSize="10" Margin="0,1"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== 区间统计页签 ==================== -->
                <TabItem Header="区间统计">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 筛选栏：两行四格（日期 / 工位方案）+ 右侧按钮。四个输入格放同一个 Grid 的同一对列，
                             标签列用 SharedSizeGroup 对齐——两个子 Grid 各写列宽会让日期格与下拉格上下错开 -->
                        <Border Grid.Row="0" Style="{StaticResource Style.PanelCard}" Padding="0" Margin="0,0,0,8">
                            <Grid Margin="12,10" Grid.IsSharedSizeScope="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="FilterLbl"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="FilterLbl"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}"/>
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="起始"/>
                                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding StatFrom}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="截止"/>
                                <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding StatTo}" VerticalAlignment="Center"/>

                                <!-- 工位/方案可手输，留空=全部 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="工位"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" VerticalAlignment="Center"
                                          ItemsSource="{Binding StationOptions}"
                                          Text="{Binding StatStation, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="方案"/>
                                <ComboBox Grid.Row="2" Grid.Column="4" IsEditable="True" VerticalAlignment="Center"
                                          ItemsSource="{Binding PlanOptions}"
                                          Text="{Binding StatPlanName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" Text="留空 = 全部"
                                           FontSize="10" Foreground="{StaticResource Brush.Text.Sub}"/>

                                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="7" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding LoadStatCommand}" Style="{StaticResource Style.PrimaryButton}"
                                            MinWidth="88" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ChartBox" Width="14" Height="14"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="加载统计" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportStatCommand}" Style="{StaticResource Style.ToolButton}"
                                            MinWidth="96" ToolTip="把当前筛选条件的统计导成 PDF（图表在文档里，界面只给表格）">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="14" Height="14"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="导出统计" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 统计结果 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,4">
                            <StackPanel>

                                <!-- 状态行：没加载过时就是引导文案，加载/导出/出错后由 ViewModel 换成结果 -->
                                <TextBlock Text="{Binding StatStatusText}" Style="{StaticResource Style.SubText}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- 统计结果体：加载过（RangeStat 非空）才显示 -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RangeStat}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- 区间内无数据 -->
                                    <TextBlock Text="区间内没有测试轮次——调整区间或先跑几轮整机测试"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.SubText}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasStatData}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasStatData}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- 汇总卡：轮次/通过/失败/未测/通过率 -->
                                        <Border Style="{StaticResource Style.PanelCard}" Padding="0" Margin="0,0,0,8">
                                            <Grid Margin="10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="测试轮次" Style="{StaticResource Style.SubText}" FontSize="10" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RangeStat.RunCount}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Text.Main}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="通过项" Style="{StaticResource Style.SubText}" FontSize="10" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RangeStat.TotalPass}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Pass}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="失败项" Style="{StaticResource Style.SubText}" FontSize="10" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RangeStat.TotalFail}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Fail}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="未测项" Style="{StaticResource Style.SubText}" FontSize="10" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RangeStat.TotalNotTested}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.NotTested}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="整体通过率" Style="{StaticResource Style.SubText}" FontSize="10" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RangeStat.PassRateText}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Primary}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 各模块通过率：比例条（有失败即红，全过才绿）+ 计数 -->
                                        <Border Style="{StaticResource Style.PanelCard}" Padding="0" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="14,10,14,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="各模块通过率" Style="{StaticResource Style.PanelTitle}"/>
                                                    <TextBlock Grid.Column="1" Text="通过率 = 通过 /（通过 + 失败）"
                                                               Style="{StaticResource Style.SubText}" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding ModuleStats}" Margin="14,0,14,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Width="150" VerticalAlignment="Center"
                                                                           Text="{Binding ModuleId, Mode=OneWay}"
                                                                           Foreground="{StaticResource Brush.Primary}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="0" Width="150" VerticalAlignment="Center" Margin="34,0,0,0"
                                                                           Text="{Binding ModuleName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource Brush.Text.Main}"/>
                                                                <Grid Grid.Column="1" Margin="10,0" Height="14" VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding PassRate, Converter={StaticResource RatioToBarColumn}}"/>
                                                                        <ColumnDefinition Width="{Binding PassRate, Converter={StaticResource RatioToBarColumn}, ConverterParameter=rest}"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="1" Background="#EEF1F5" CornerRadius="3"/>
                                                                    <Border Grid.Column="0" CornerRadius="3">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{StaticResource Brush.Pass}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasFail}" Value="True">
                                                                                        <Setter Property="Background" Value="{StaticResource Brush.Fail}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Width="190"
                                                                           Text="{Binding CountsText}"/>
                                                                <TextBlock Grid.Column="2" Margin="150,0,0,0" VerticalAlignment="Center" Width="40"
                                                                           Text="{Binding PassRateText}" FontWeight="Bold"
                                                                           Foreground="{StaticResource Brush.Text.Main}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- NG 原因汇总 -->
                                        <Border Style="{StaticResource Style.PanelCard}" Padding="0" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="14,10,14,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="NG 原因汇总" Style="{StaticResource Style.PanelTitle}"/>
                                                    <TextBlock Grid.Column="1" Text="失败测试项按项名聚合，备注取最近一次"
                                                               Style="{StaticResource Style.SubText}" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="区间内没有失败项" Margin="14,0,14,10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Style.SubText}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NgReasons.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding NgReasons}" Margin="14,0,14,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Width="150" VerticalAlignment="Center"
                                                                           Text="{Binding ModuleId}"
                                                                           Foreground="{StaticResource Brush.Primary}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                                                           Text="{Binding ItemName}" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource Brush.Text.Main}"/>
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Width="150"
                                                                           Text="{Binding RemarkText}" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource Brush.Text.Sub}"/>
                                                                <TextBlock Grid.Column="2" Margin="150,0,0,0" VerticalAlignment="Center" Width="50"
                                                                           Text="{Binding FailCount}" TextAlignment="Right" FontWeight="Bold"
                                                                           Foreground="{StaticResource Brush.Fail}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- 按天趋势 -->
                                        <Border Style="{StaticResource Style.PanelCard}" Padding="0" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="14,10,14,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="按天趋势" Style="{StaticResource Style.PanelTitle}"/>
                                                    <TextBlock Grid.Column="1" Text="图表在导出的统计 PDF 里"
                                                               Style="{StaticResource Style.SubText}" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Trend}" Margin="14,0,14,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Width="150" VerticalAlignment="Center"
                                                                           Text="{Binding DateText}"
                                                                           Foreground="{StaticResource Brush.Text.Main}"/>
                                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                                                           Text="{Binding CountsText}"
                                                                           Foreground="{StaticResource Brush.Text.Sub}"/>
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Width="80"
                                                                           Text="{Binding PassRateText}" TextAlignment="Right" FontWeight="Bold"
                                                                           Foreground="{StaticResource Brush.Text.Main}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
