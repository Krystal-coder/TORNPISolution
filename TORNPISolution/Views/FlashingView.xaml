<UserControl x:Class="TORNPISolution.Views.FlashingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:TORNPISolution.Converters"
             xmlns:viewModels="clr-namespace:TORNPISolution.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FontFamily="Microsoft YaHei UI"
             d:DataContext="{d:DesignInstance Type=viewModels:FlashingViewModel}"
             d:DesignHeight="720" d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:LenientNumberConverter x:Key="Num"/>

        <!-- 页面样式 -->
        <Style x:Key="Style.FlashCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Panel.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Running}">
                    <Setter Property="Background" Value="{StaticResource Brush.Primary.Light}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Waiting}">
                    <Setter Property="Background" Value="{StaticResource Brush.Wait.Light}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Wait}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Success}">
                    <Setter Property="Background" Value="{StaticResource Brush.Pass.Light}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Failed}">
                    <Setter Property="Background" Value="{StaticResource Brush.Fail.Light}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Fail}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Skipped}">
                    <Setter Property="Background" Value="{StaticResource Brush.Skipped.Light}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Skipped}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 结果角标 -->
        <Style x:Key="Style.CardBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="#E9EEF4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Running}">
                    <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Waiting}">
                    <Setter Property="Background" Value="{StaticResource Brush.Wait}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Success}">
                    <Setter Property="Background" Value="{StaticResource Brush.Pass}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Failed}">
                    <Setter Property="Background" Value="{StaticResource Brush.Fail}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visual}" Value="{x:Static viewModels:ChannelVisual.Skipped}">
                    <Setter Property="Background" Value="{StaticResource Brush.Skipped}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.CardBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 卡片里的小标签 -->
        <Style x:Key="Style.CardField" TargetType="TextBlock" BasedOn="{StaticResource Style.SubText}">
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- 汇总页通道卡片 -->
        <DataTemplate x:Key="Tpl.ChannelCard">
            <Border Style="{StaticResource Style.FlashCard}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="开始测试" Click="ChannelStart_Click"
                                  ToolTip="只烧这一路（哪怕它没勾参与整批）；本轮已有别的路在跑时不会叠开"/>
                        <MenuItem Header="停止测试" Click="ChannelStop_Click"
                                  ToolTip="只停这一路，其余路照常跑完"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected, Mode=TwoWay}"
                                  IsEnabled="{Binding IsIdle}" VerticalAlignment="Center"
                                  ToolTip="本轮要不要烧这一路（勾掉的路不会报错，只会一直停在等待开始）">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Main}" Margin="6,0,0,0"/>
                        </CheckBox>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Style.CardBadge}"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Style.CardBadgeText}"/>
                        </Border>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Style.CardField}"/>
                        <TextBlock Text="·" Style="{StaticResource Style.CardField}" Margin="4,0"/>
                        <TextBlock Text="{Binding PortLabel}" Style="{StaticResource Style.CardField}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding StageText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Main}"/>
                        <TextBlock Text="{Binding PercentText}" FontSize="12" FontWeight="Bold" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.Primary}"/>
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Style.CardField}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <ProgressBar Grid.Row="3" Height="6" Minimum="0" Maximum="100" Margin="0,6,0,0"
                                 VerticalAlignment="Top" BorderThickness="0"
                                 Value="{Binding PercentValue, Mode=OneWay}"
                                 Foreground="{StaticResource Brush.Primary}" Background="#E4E9F0"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Grid.Row="3" Margin="0,18,0,0" VerticalAlignment="Top" FontSize="11"
                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Text.Sub}" Text="{Binding DetailText}"/>
                </Grid>
            </Border>
        </DataTemplate>


    </UserControl.Resources>

    <!-- 卡片行 -->
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头：本轮动作 + 开烧/停止 -->
        <Border Grid.Row="0" Style="{StaticResource Style.PanelCard}" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="烧录工位" Style="{StaticResource Style.PanelTitle}"/>
                    <TextBlock Text="先烧 SPI Flash，再烧富芮坤主控"
                               Style="{StaticResource Style.SubText}" Margin="0,3,0,0"/>
                </StackPanel>

       
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="FlashJob" IsChecked="{Binding IsAllJob}"
                                 IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center"
                                 Content="All" Margin="0,0,12,0" FontSize="13" FontWeight="Bold"
                                 ToolTip="先整批烧 Flash，整批落定后再整批烧富芮坤"/>
                    <RadioButton GroupName="FlashJob" IsChecked="{Binding IsFlashJob}"
                                 IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center"
                                 Content="烧 Flash" Margin="0,0,12,0" FontSize="13"/>
                    <RadioButton GroupName="FlashJob" IsChecked="{Binding IsFreqchipJob}"
                                 IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center"
                                 Content="烧富芮坤" FontSize="13"/>
                    <Border Background="#EEF2F7" CornerRadius="4" Padding="8,3" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PhaseText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Main}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="全选" Style="{StaticResource Style.ToolButton}"
                            Command="{Binding CheckAllChannelsCommand}" ToolTip="把已启用的路都勾上"/>
                    <Button Content="全不选" Style="{StaticResource Style.ToolButton}"
                            Command="{Binding UncheckAllChannelsCommand}"/>
                    <Button Content="清空结果" Style="{StaticResource Style.ToolButton}"
                            Command="{Binding ResetResultsCommand}"/>
                    <Button Content="停止" Style="{StaticResource Style.ToolButton}"
                            Command="{Binding StopRoundCommand}"
                            ToolTip="正在跑的那几路各自收尾，其余不再启动（只想停一路：右键那张卡片）"/>
                    <Button Style="{StaticResource Style.PrimaryButton}" Command="{Binding StartRoundCommand}"
                            ToolTip="按当前勾的范围并发开一轮（开烧前会先把配置落盘）">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FlashOutline" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="开始烧录" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ActionHintText}" Style="{StaticResource Style.SubText}" TextWrapping="Wrap"/>
                    <TextBlock Text="参数在菜单「配置 → 烧录配置」里改：「全局参数」是两颗芯片共用的，「通道配置」一行就是一条路"
                               Style="{StaticResource Style.SubText}" Foreground="{StaticResource Brush.Primary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--  主体：左=通道卡片汇总，右=选中通道的明细时间线  -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Style.PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 汇总条 -->
                    <Grid Grid.Row="0" Margin="14,10,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="通道汇总" Style="{StaticResource Style.PanelTitle}"/>
                            <TextBlock Text="{Binding RoundSummaryText}" Style="{StaticResource Style.SubText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RoundElapsedText}" Style="{StaticResource Style.SubText}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding RoundId}" Style="{StaticResource Style.SubText}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border CornerRadius="4" Padding="12,4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EEF1F5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RoundVisual}" Value="{x:Static viewModels:ChannelVisual.Running}">
                                                <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RoundVisual}" Value="{x:Static viewModels:ChannelVisual.Waiting}">
                                                <Setter Property="Background" Value="{StaticResource Brush.Wait}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RoundVisual}" Value="{x:Static viewModels:ChannelVisual.Success}">
                                                <Setter Property="Background" Value="{StaticResource Brush.Pass}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RoundVisual}" Value="{x:Static viewModels:ChannelVisual.Failed}">
                                                <Setter Property="Background" Value="{StaticResource Brush.Fail}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding VerdictText}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                
                    <ListBox Grid.Row="2" Margin="8,6,8,8"
                             ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                             ItemTemplate="{StaticResource Tpl.ChannelCard}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <!-- 与单板页同一处修正：自定义 ItemTemplate 带不走 Adorner 层的焦点点阵框，
                                     它会与 Ring 那圈选中描边叠成两层边。描边本身就是这里的焦点指示 -->
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Ring" BorderThickness="0" CornerRadius="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.Text.Sub}"/>
                                                    <Setter TargetName="Ring" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右：通道明细时间线 -->
            <Border Grid.Column="2" Style="{StaticResource Style.PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="点一张卡片看这一路的往来明细" Style="{StaticResource Style.SubText}"
                               TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Margin="16" Visibility="{Binding HasSelectedCard, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <Grid Grid.Row="0" Margin="14,10,14,0"
                          Visibility="{Binding HasSelectedCard, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedCard.Title}" Style="{StaticResource Style.PanelTitle}"/>
                            <TextBlock Style="{StaticResource Style.SubText}" Margin="0,4,0,0"
                                       Text="{Binding SelectedCard.Name, StringFormat=位号：{0}}"/>
                            <TextBlock Style="{StaticResource Style.SubText}" Margin="0,2,0,0"
                                       Text="{Binding SelectedCard.PortLabel, StringFormat=本动作串口：{0}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SelectedCard.ElapsedText}" Style="{StaticResource Style.SubText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Style="{StaticResource Style.CardBadge}" DataContext="{Binding SelectedCard}">
                                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Style.CardBadgeText}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="14,8,14,0" TextWrapping="Wrap"
                               DataContext="{Binding SelectedCard}" Text="{Binding Detail}"
                               FontSize="12" Foreground="{StaticResource Brush.Text.Main}"
                               Visibility="{Binding DataContext.HasSelectedCard,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource BoolToVisibility}}"/>

                    <!-- 时间线 -->
                    <ScrollViewer x:Name="TraceScroll" Grid.Row="2" Margin="14,8,8,8"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0"
                                  Visibility="{Binding HasSelectedCard, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding SelectedCard.Trace}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="NoWrap" Margin="0,1"
                                               Foreground="{StaticResource Brush.Text.Main}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,10">
                        <TextBlock Text="复制整份报文" Style="{StaticResource Style.SubText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="复制明细" Style="{StaticResource Style.ToolButton}"
                                Command="{Binding CopyTraceCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 状态条：提示、校验问题、探测结果、记录目录 ==================== -->
        <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource Style.PanelCard}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Text.Main}"
                               Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding ConfigIssueText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{StaticResource Brush.Fail}"
                               Visibility="{Binding HasConfigIssueText, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding IsDetectingText}" Style="{StaticResource Style.SubText}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding DetectText}" FontSize="11" Foreground="{StaticResource Brush.Text.Sub}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RecordDirectory, StringFormat=记录目录：{0}}"
                               Style="{StaticResource Style.SubText}" HorizontalAlignment="Right"/>
                    <Button Content="打开记录文件夹" Style="{StaticResource Style.ToolButton}" HorizontalAlignment="Right"
                            Margin="0,4,0,0" Command="{Binding OpenRecordFolderCommand}"
                            ToolTip="一轮每通道一行，按日期一个 CSV；MES 接口没定之前，追溯全靠这份文件"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
